{% comment %}
  Product image landing 2 — order form + optional images below.
{% endcomment %}

<div
  class="ishraq-product-landing full-width"
  style="
    --landing-spacing-before-form: {{ section.settings.spacing_before_form }}px;
    --landing-spacing-after-form: {{ section.settings.spacing_after_form }}px;
    --landing-form-padding-inline: {{ section.settings.form_padding_inline }}px;
    --landing-block-gap: {{ section.settings.block_gap }}px;
  "
>
  {% assign order_form_open = false %}
  {% if section.blocks.size > 0 %}
    {% for block in section.blocks %}
      {% case block.type %}
        {% when 'order_form' %}
          {% if order_form_open %}
            {% render 'product-landing-order-form', product: product, section: section, part: 'close' %}
          {% endif %}
          {% render 'product-landing-order-form', product: product, section: section, block: block, part: 'open' %}
          {% assign order_form_open = true %}

        {% when '@app' %}
          {% if order_form_open %}
            <div class="ishraq-product-landing__app" {{ block.shopify_attributes }}>
              {% render block %}
            </div>
          {% else %}
            <div class="ishraq-product-landing__inner" {{ block.shopify_attributes }}>
              <section id="cod-order" class="ishraq-product-landing__order">
                <div class="ishraq-product-landing__card">
                  {% render block %}
                </div>
              </section>
            </div>
          {% endif %}

        {% when 'fullscreen_image' %}
          {% if order_form_open %}
            {% render 'product-landing-order-form', product: product, section: section, part: 'close' %}
            {% assign order_form_open = false %}
          {% endif %}
          {% render 'product-landing-fullscreen-image', block: block, alt_fallback: product.title %}

        {% when 'product_image' %}
          {% if order_form_open %}
            {% render 'product-landing-order-form', product: product, section: section, part: 'close' %}
            {% assign order_form_open = false %}
          {% endif %}
          {% render 'product-landing-product-image', block: block, product: product %}
      {% endcase %}
    {% endfor %}
    {% if order_form_open %}
      {% render 'product-landing-order-form', product: product, section: section, part: 'close' %}
    {% endif %}
  {% else %}
    {% render 'product-landing-order-form', product: product, section: section, part: 'open' %}
    {% render 'product-landing-order-form', product: product, section: section, part: 'close' %}
  {% endif %}

  <div class="ishraq-product-landing__sticky">
    <a href="#cod-order" class="btn btn--primary btn--lg ishraq-product-landing__sticky-btn">
      {{ section.settings.sticky_label | default: 'كمّلي الطلب' }}
    </a>
  </div>
</div>

{% stylesheet %}
  .ishraq-product-landing {
    padding-bottom: 5.5rem;
  }

  .ishraq-product-landing__inner {
    width: min(100%, 48rem);
    margin-inline: auto;
  }

  .ishraq-product-landing__figure {
    margin: 0;
  }

  .ishraq-product-landing__inner + .ishraq-product-landing__figure,
  .ishraq-product-landing__figure + .ishraq-product-landing__figure,
  .ishraq-product-landing__inner + .ishraq-product-landing__inner {
    margin-top: var(--landing-block-gap, 0);
  }

  .ishraq-product-landing__figure--bleed {
    width: 100%;
    max-width: none;
  }

  .ishraq-product-landing__image {
    display: block;
    width: 100%;
    height: auto;
  }

  @media (max-width: 767px) {
    .ishraq-product-landing {
      padding-inline: 0;
      overflow-x: clip;
    }

    .ishraq-product-landing__figure--bleed {
      width: 100vw;
      max-width: 100vw;
      margin-inline: calc(50% - 50vw);
    }

    .ishraq-product-landing__figure--bleed .ishraq-product-landing__image {
      width: 100%;
      max-width: none;
      height: auto;
      border-radius: 0;
    }

    .ishraq-product-landing__figure--fullscreen {
      min-height: 100svh;
      display: flex;
      align-items: stretch;
    }

    .ishraq-product-landing__figure--fullscreen .ishraq-product-landing__image {
      width: 100%;
      min-height: 100svh;
      height: 100%;
      object-fit: cover;
      object-position: center;
    }
  }

  .ishraq-product-landing__order {
    border-block: 1px solid color-mix(in srgb, var(--brand-800) 10%, transparent);
    background: var(--ivory-100);
    padding-top: var(--landing-spacing-before-form, 0);
    padding-bottom: var(--landing-spacing-after-form, 2.5rem);
    padding-inline: var(--landing-form-padding-inline, 1rem);
    margin: 0;
  }

  .ishraq-product-landing__card {
    max-width: 36rem;
    margin-inline: auto;
    padding: 1.25rem;
    border-radius: 1.75rem;
    border: 1px solid color-mix(in srgb, var(--brand-800) 10%, transparent);
    background: var(--white);
    box-shadow: 0 24px 60px -38px color-mix(in srgb, var(--brand-950) 45%, transparent);
  }

  .ishraq-product-landing__eyebrow {
    margin: 0;
    font-size: 0.875rem;
    font-weight: 800;
    color: var(--brass-600);
  }

  .ishraq-product-landing__title {
    margin: 0.5rem 0 0;
    font-size: clamp(1.5rem, 4.5vw, 1.875rem);
    font-weight: 900;
    line-height: 1.35;
    color: var(--brand-950);
  }

  .ishraq-product-landing__intro {
    margin: 0.75rem 0 0;
    font-size: 0.875rem;
    line-height: 1.7;
    color: var(--ink-600);
    font-weight: 700;
  }

  .ishraq-product-landing__app-slot {
    margin-top: 1.5rem;
  }

  .ishraq-product-landing__app {
    margin-top: 0;
  }

  .ishraq-product-landing__trust {
    margin: 0.75rem 0 0;
    font-size: 0.75rem;
    font-weight: 700;
    line-height: 1.6;
    text-align: center;
    color: var(--ink-600);
  }

  .ishraq-product-landing__sticky {
    display: none;
    position: fixed;
    inset-inline: 0;
    bottom: 0;
    z-index: 30;
    padding: 0.75rem;
    border-top: 1px solid color-mix(in srgb, var(--brand-800) 10%, transparent);
    background: color-mix(in srgb, var(--ivory-50) 95%, transparent);
    backdrop-filter: blur(8px);
  }

  .ishraq-product-landing__sticky-btn {
    display: flex;
    width: 100%;
    justify-content: center;
    text-decoration: none;
  }

  @media (min-width: 768px) {
    .ishraq-product-landing__card {
      padding: 2rem;
    }

    .ishraq-product-landing__figure--fullscreen {
      min-height: auto;
    }

    .ishraq-product-landing__figure--fullscreen .ishraq-product-landing__image {
      min-height: auto;
      height: auto;
      object-fit: contain;
    }
  }

  @media (max-width: 767px) {
    .ishraq-product-landing__sticky {
      display: block;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Product image landing 2",
  "tag": "section",
  "class": "product-image-landing-2-section",
  "settings": [
    {
      "type": "paragraph",
      "content": "Add the Order form block, then an EasySell COD Form app block inside it. Optional images below."
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "أداء عند الاستلام · تأكيد قبل الإرسال"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Title override",
      "info": "Leave blank to use product title."
    },
    {
      "type": "textarea",
      "id": "intro",
      "label": "Intro override",
      "info": "Leave blank to use product description excerpt."
    },
    {
      "type": "text",
      "id": "sticky_label",
      "label": "Mobile sticky button",
      "default": "كمّلي الطلب"
    },
    {
      "type": "text",
      "id": "trust_note",
      "label": "Trust note",
      "default": "✓ تأكيد هاتفي قبل الإرسال · ✓ الدفع عند الاستلام · ✓ توصيل المغرب"
    },
    {
      "type": "header",
      "content": "Spacing"
    },
    {
      "type": "range",
      "id": "spacing_before_form",
      "label": "Space before order form",
      "min": 0,
      "max": 80,
      "step": 4,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "spacing_after_form",
      "label": "Space after order form",
      "min": 0,
      "max": 80,
      "step": 4,
      "unit": "px",
      "default": 40
    },
    {
      "type": "range",
      "id": "block_gap",
      "label": "Space between blocks",
      "min": 0,
      "max": 80,
      "step": 4,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "form_padding_inline",
      "label": "Form side padding",
      "min": 0,
      "max": 60,
      "step": 4,
      "unit": "px",
      "default": 16
    }
  ],
  "blocks": [
    {
      "type": "order_form",
      "name": "Order form",
      "limit": 1
    },
    {
      "type": "@app"
    },
    {
      "type": "fullscreen_image",
      "name": "Full screen image",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "text",
          "id": "alt",
          "label": "Alt text"
        },
        {
          "type": "checkbox",
          "id": "mobile_full_screen",
          "label": "Full screen on mobile",
          "default": true
        }
      ]
    },
    {
      "type": "product_image",
      "name": "Product image",
      "settings": [
        {
          "type": "checkbox",
          "id": "use_featured",
          "label": "Use featured product image",
          "default": true
        },
        {
          "type": "range",
          "id": "image_index",
          "label": "Product image number",
          "min": 1,
          "max": 10,
          "step": 1,
          "default": 1
        },
        {
          "type": "checkbox",
          "id": "mobile_full_screen",
          "label": "Full screen on mobile",
          "default": false
        }
      ]
    }
  ],
  "disabled_on": {
    "groups": ["header", "footer"]
  }
}
{% endschema %}
