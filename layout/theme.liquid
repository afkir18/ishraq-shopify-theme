<!doctype html>
<html lang="ar" dir="rtl">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    {% render 'css-variables' %}

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link
      href="https://fonts.googleapis.com/css2?family=Cairo:wght@600;700;800;900&display=swap"
      rel="stylesheet"
    >

    {{ 'critical.css' | asset_url | stylesheet_tag: preload: true }}
    {{ 'ishraq.css' | asset_url | stylesheet_tag }}

    {% render 'meta-tags' %}
    {{ content_for_header }}
  </head>

  <body{% if page.handle == 'contact' or page.handle == 'shipping' or page.template_suffix == 'shipping' %} class="page-contact"{% endif %}>
    {% sections 'header-group' %}
    <main id="main-content">
      {{ content_for_layout }}
    </main>
    {% sections 'footer-group' %}
    {% render 'cart-drawer' %}

    {% if page.handle == 'contact' or page.handle == 'shipping' or page.template_suffix == 'shipping' %}
      <style>
        .page-contact .es-popup-button,
        .page-contact .es-popup-button-product,
        .page-contact .es-popup-button-overwrite,
        .page-contact [class*="es-popup-button"],
        .page-contact [class*="es-sticky"],
        .page-contact [id^="es-"] {
          display: none !important;
        }
      </style>
      <script>
        (function () {
          function hideEasySellOrderButton() {
            document.querySelectorAll('a, button').forEach(function (el) {
              var text = (el.textContent || '').replace(/\s+/g, ' ').trim();
              if (text.indexOf('اضغط هنا للطلب') !== -1) {
                el.style.setProperty('display', 'none', 'important');
              }
            });
          }
          hideEasySellOrderButton();
          document.addEventListener('DOMContentLoaded', hideEasySellOrderButton);
          setTimeout(hideEasySellOrderButton, 800);
          setTimeout(hideEasySellOrderButton, 2000);
        })();
      </script>
    {% endif %}
  </body>
</html>
