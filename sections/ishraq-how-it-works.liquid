<section class="ishraq-steps full-width">
  <div class="page-width">
    <p class="section-label">{{ section.settings.label | default: "كيفاش كتخدم تجربة الطلب" }}</p>
    <h2>{{ section.settings.heading | default: "من الاختيار للباب — بكل شفافية" }}</h2>
    <div class="ishraq-steps__grid">
      {% for block in section.blocks %}
        <div class="ishraq-steps__item card" {{ block.shopify_attributes }}>
          <p class="ishraq-steps__num">{{ block.settings.number }}</p>
          <h3>{{ block.settings.title }}</h3>
          <p>{{ block.settings.body }}</p>
        </div>
      {% endfor %}
    </div>
  </div>
</section>

{% stylesheet %}
  .ishraq-steps {
    border-block: 1px solid color-mix(in srgb, var(--brand-800) 8%, transparent);
    background: var(--white);
    padding-block: 4rem 5rem;
  }

  .ishraq-steps h2 {
    max-width: 42rem;
    font-size: clamp(1.875rem, 4vw, 2.25rem);
    color: var(--brand-950);
  }

  .ishraq-steps__grid {
    display: grid;
    gap: 1.25rem;
    margin-top: 2.5rem;
  }

  .ishraq-steps__item {
    padding: 1.5rem;
  }

  .ishraq-steps__num {
    font-size: 1.5rem;
    font-weight: 900;
    color: var(--brass-600);
  }

  .ishraq-steps__item h3 {
    margin-top: 0.75rem;
    font-size: 1.125rem;
    color: var(--brand-950);
  }

  .ishraq-steps__item p {
    margin-top: 0.5rem;
    font-size: 0.875rem;
    line-height: 1.6;
    color: var(--ink-600);
  }

  @media (min-width: 640px) {
    .ishraq-steps__grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 1024px) {
    .ishraq-steps__grid {
      grid-template-columns: repeat(4, 1fr);
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Ishraq How It Works",
  "settings": [
    { "type": "text", "id": "label", "label": "Section label" },
    { "type": "text", "id": "heading", "label": "Heading" }
  ],
  "blocks": [
    {
      "type": "step",
      "name": "Step",
      "settings": [
        { "type": "text", "id": "number", "label": "Number" },
        { "type": "text", "id": "title", "label": "Title" },
        { "type": "textarea", "id": "body", "label": "Body" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Ishraq How It Works",
      "blocks": [
        { "type": "step", "settings": { "number": "01", "title": "اختاري المنتوج", "body": "كولاجين بحري أو ماغنيسيوم غليسينات — حسب هدفك." } },
        { "type": "step", "settings": { "number": "02", "title": "كمّلي الطلب", "body": "الاسم، الهاتف، والعنوان. بلا بطاقة بنكية." } },
        { "type": "step", "settings": { "number": "03", "title": "تأكيد بالهاتف", "body": "فريق إشراق كيتواصل معاك قبل ما يتسيّط الطلب." } },
        { "type": "step", "settings": { "number": "04", "title": "استلام ودفع", "body": "توصيل لباب الدار والأداء عند الاستلام." } }
      ]
    }
  ]
}
{% endschema %}
