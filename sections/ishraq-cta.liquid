<section class="ishraq-cta full-width">
  <div class="ishraq-cta__bg">
    {% if section.settings.background != blank %}
      {{ section.settings.background | image_url: width: 1600 | image_tag: loading: 'lazy', alt: '' }}
    {% else %}
      <img src="{{ 'home-cta-bg.png' | asset_url }}" alt="" width="1600" height="900" loading="lazy" aria-hidden="true">
    {% endif %}
  </div>
  <div class="ishraq-cta__content page-width">
    <p class="ishraq-cta__label">{{ section.settings.label | default: "وعد إشراق للمغرب" }}</p>
    <h2>{{ section.settings.heading | default: "منتوج يستاهل الثقة — مشي تجربة كتندمي عليها" }}</h2>
    <p>{{ section.settings.subheading | default: "عناية بالبشرة · عناية بالشعر · مكملات وغوميز · أداء عند الاستلام" }}</p>
    <div class="ishraq-cta__actions">
      <a href="{{ section.settings.primary_link | default: routes.all_products_collection_url }}" class="btn btn--white btn--lg">
        {{ section.settings.primary_label | default: "ابدئي الطلب الآن" }}
      </a>
      {% if section.settings.secondary_link != blank or pages.contact %}
        <a href="{{ section.settings.secondary_link | default: pages.contact.url }}" class="btn btn--secondary btn--lg ishraq-cta__secondary">
          {{ section.settings.secondary_label | default: "عندك سؤال؟" }}
        </a>
      {% endif %}
    </div>
  </div>
</section>

{% stylesheet %}
  .ishraq-cta {
    position: relative;
    overflow: hidden;
    background: var(--brand-800);
    color: var(--ivory-50);
    padding-block: 4rem 5rem;
  }

  .ishraq-cta__bg {
    position: absolute;
    inset: 0;
    opacity: 0.2;
  }

  .ishraq-cta__bg img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .ishraq-cta__content {
    position: relative;
    max-width: 48rem;
    text-align: center;
  }

  .ishraq-cta__label {
    font-size: 0.875rem;
    font-weight: 700;
    color: var(--brass-300);
  }

  .ishraq-cta h2 {
    margin-top: 0.75rem;
    font-size: clamp(1.875rem, 4vw, 2.25rem);
  }

  .ishraq-cta__content > p {
    margin-top: 1rem;
    color: color-mix(in srgb, var(--ivory-50) 85%, transparent);
  }

  .ishraq-cta__actions {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.75rem;
    margin-top: 2rem;
  }

  .ishraq-cta__secondary {
    border-color: color-mix(in srgb, var(--white) 50%, transparent);
    background: color-mix(in srgb, var(--white) 10%, transparent);
    color: var(--white);
    backdrop-filter: blur(4px);
  }

  .ishraq-cta__secondary:hover {
    border-color: var(--white);
    background: color-mix(in srgb, var(--white) 20%, transparent);
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Ishraq CTA",
  "settings": [
    { "type": "text", "id": "label", "label": "Label" },
    { "type": "text", "id": "heading", "label": "Heading" },
    { "type": "textarea", "id": "subheading", "label": "Subheading" },
    { "type": "text", "id": "primary_label", "label": "Primary button label" },
    { "type": "url", "id": "primary_link", "label": "Primary button link" },
    { "type": "text", "id": "secondary_label", "label": "Secondary button label" },
    { "type": "url", "id": "secondary_link", "label": "Secondary button link" },
    { "type": "image_picker", "id": "background", "label": "Background image" }
  ],
  "presets": [{ "name": "Ishraq CTA" }]
}
{% endschema %}
