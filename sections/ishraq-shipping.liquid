{% comment %}
  Ishraq shipping & returns page.
{% endcomment %}

{% liquid
  assign whatsapp_digits = section.settings.whatsapp_number | replace: ' ', '' | replace: '-', '' | replace: '+', '' | replace: '(', '' | replace: ')', ''
  assign whatsapp_message = section.settings.whatsapp_message | url_encode
  assign whatsapp_url = 'https://wa.me/' | append: whatsapp_digits
  if section.settings.whatsapp_message != blank
    assign whatsapp_url = whatsapp_url | append: '?text=' | append: whatsapp_message
  endif
  assign contact_url = pages.contact.url | default: '/pages/contact'
%}

<section class="ishraq-shipping full-width">
  <div class="ishraq-shipping__hero page-width">
    <h1>{{ section.settings.heading | default: 'التوصيل والإرجاع' }}</h1>
    <p class="ishraq-shipping__lead">
      {{ section.settings.lead | default: 'توصيل لجميع مدن المغرب، أداء عند الاستلام، وتأكيد هاتفي قبل ما يخرج الطلب. سياسة واضحة — بلا مفاجآت.' }}
    </p>
  </div>

  <div class="ishraq-shipping__highlights page-width">
    <div class="ishraq-shipping__card card">
      <span class="ishraq-shipping__icon" aria-hidden="true">🇲🇦</span>
      <h2>{{ section.settings.card_1_title | default: 'توصيل المغرب كامل' }}</h2>
      <p>{{ section.settings.card_1_body | default: 'كنوصلو لجميع المدن والجهات. المدة كتختلف حسب المدينة.' }}</p>
    </div>
    <div class="ishraq-shipping__card card">
      <span class="ishraq-shipping__icon" aria-hidden="true">💵</span>
      <h2>{{ section.settings.card_2_title | default: 'أداء عند الاستلام' }}</h2>
      <p>{{ section.settings.card_2_body | default: 'ما كندفعوش أونلاين. كتخلّصي غير ملي يوصل الطلب لباب الدار.' }}</p>
    </div>
    <div class="ishraq-shipping__card card">
      <span class="ishraq-shipping__icon" aria-hidden="true">📞</span>
      <h2>{{ section.settings.card_3_title | default: 'تأكيد قبل الإرسال' }}</h2>
      <p>{{ section.settings.card_3_body | default: 'كنعيطو ليك باش نأكّدو الاسم، الهاتف، والعنوان قبل ما يتسيّط الطلب.' }}</p>
    </div>
    <div class="ishraq-shipping__card card">
      <span class="ishraq-shipping__icon" aria-hidden="true">⏱️</span>
      <h2>{{ section.settings.card_4_title | default: 'مدة التوصيل' }}</h2>
      <p>{{ section.settings.card_4_body | default: '24–48 ساعة فالمدن الكبرى · 2–4 أيام لباقي المدن والقرى.' }}</p>
    </div>
  </div>

  <div class="ishraq-shipping__policies page-width">
    <article class="ishraq-shipping__policy card">
      <h2>{{ section.settings.delivery_title | default: 'التوصيل' }}</h2>
      <ul>
        <li>{{ section.settings.delivery_1 | default: 'كنخدمو مع شركات توصيل موثوقة داخل المغرب.' }}</li>
        <li>{{ section.settings.delivery_2 | default: 'بعد التأكيد بالهاتف، الطلب كيخرج في أقرب آجال.' }}</li>
        <li>{{ section.settings.delivery_3 | default: 'المدن الكبرى (الدار البيضاء، الرباط، مراكش، فاس، طنجة…): عادة 24 إلى 48 ساعة.' }}</li>
        <li>{{ section.settings.delivery_4 | default: 'باقي المدن والجهات: عادة من يومين حتى 4 أيام عمل.' }}</li>
        <li>{{ section.settings.delivery_5 | default: 'سعر التوصيل كيبان فالطلب. بعض العروض كيكون فيها توصيل مجاني.' }}</li>
        <li>{{ section.settings.delivery_6 | default: 'إلا ما ردّيتيش على اتصال التأكيد، الطلب ما كيتسيّطش حتى نتأكدو منك.' }}</li>
      </ul>
    </article>

    <article class="ishraq-shipping__policy card">
      <h2>{{ section.settings.returns_title | default: 'الإرجاع والاستبدال' }}</h2>
      <ul>
        <li>{{ section.settings.return_1 | default: 'إلا وصلك منتوج غالط أو تالف، راسلينا فنفس اليوم عبر واتساب ونبدّلوه.' }}</li>
        <li>{{ section.settings.return_2 | default: 'تقدر تطلبي الإرجاع خلال 7 أيام من الاستلام، إلا كان المنتوج مغلق وماستعملتيش.' }}</li>
        <li>{{ section.settings.return_3 | default: 'منتجات العناية والمكملات ما كترجعش إلا كانت مفتوحة أو مستعملة — لأسباب صحية.' }}</li>
        <li>{{ section.settings.return_4 | default: 'كنراجعو الطلب قبل ما نوافقو على الإرجاع. التصوير كيساعد يسرّع المعالجة.' }}</li>
        <li>{{ section.settings.return_5 | default: 'بعد الموافقة، كنبدّلو المنتوج أو كنلغيو الطلب حسب الحالة.' }}</li>
        <li>{{ section.settings.return_6 | default: 'الأداء عند الاستلام: ما كاينش إرجاع فلوس أونلاين — الحل هو استبدال أو إلغاء قبل الإرسال.' }}</li>
      </ul>
    </article>
  </div>

  {% if page.content != blank %}
    <div class="ishraq-shipping__page-content rte page-width card">
      {{ page.content }}
    </div>
  {% endif %}

  <div class="ishraq-shipping__cta page-width">
    <p>{{ section.settings.cta_text | default: 'عندك سؤال على التوصيل أو الإرجاع؟' }}</p>
    <div class="ishraq-shipping__cta-actions">
      {% if whatsapp_digits != blank %}
        <a
          href="{{ whatsapp_url }}"
          class="btn btn--whatsapp btn--lg"
          target="_blank"
          rel="noopener noreferrer"
        >
          {{ section.settings.whatsapp_label | default: 'واتساب إشراق' }}
        </a>
      {% endif %}
      <a href="{{ contact_url }}" class="btn btn--secondary btn--lg">
        {{ section.settings.contact_label | default: 'تواصل معنا' }}
      </a>
    </div>
  </div>
</section>

{% stylesheet %}
  .ishraq-shipping {
    padding-block: 2.5rem 4.5rem;
  }

  .ishraq-shipping__hero {
    max-width: 42rem;
    margin-inline: auto;
    margin-bottom: 2.5rem;
    text-align: center;
  }

  .ishraq-shipping__hero h1 {
    font-size: clamp(1.875rem, 5vw, 2.5rem);
    font-weight: 900;
    color: var(--brand-950);
  }

  .ishraq-shipping__lead {
    margin-top: 0.75rem;
    font-size: 1.0625rem;
    line-height: 1.8;
    color: var(--ink-600);
  }

  .ishraq-shipping__highlights {
    display: grid;
    gap: 1rem;
    margin-bottom: 1.75rem;
  }

  .ishraq-shipping__card {
    padding: 1.25rem;
  }

  .ishraq-shipping__icon {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 2.75rem;
    height: 2.75rem;
    margin-bottom: 0.75rem;
    border-radius: 0.875rem;
    background: color-mix(in srgb, var(--brand-800) 8%, transparent);
    font-size: 1.25rem;
  }

  .ishraq-shipping__card h2 {
    font-size: 1.0625rem;
    color: var(--brand-950);
  }

  .ishraq-shipping__card p {
    margin-top: 0.4rem;
    font-size: 0.875rem;
    line-height: 1.7;
    color: var(--ink-600);
  }

  .ishraq-shipping__policies {
    display: grid;
    gap: 1.25rem;
  }

  .ishraq-shipping__policy {
    padding: 1.5rem;
  }

  .ishraq-shipping__policy h2 {
    margin-bottom: 1rem;
    font-size: 1.25rem;
    color: var(--brand-950);
  }

  .ishraq-shipping__policy ul {
    display: grid;
    gap: 0.75rem;
    padding: 0;
    margin: 0;
    list-style: none;
  }

  .ishraq-shipping__policy li {
    position: relative;
    padding-inline-start: 1.5rem;
    font-size: 0.9375rem;
    line-height: 1.75;
    color: var(--ink-600);
  }

  .ishraq-shipping__policy li::before {
    content: '';
    position: absolute;
    inset-inline-start: 0;
    top: 0.7rem;
    width: 0.5rem;
    height: 0.5rem;
    border-radius: 9999px;
    background: var(--brass-600);
  }

  .ishraq-shipping__page-content {
    margin-top: 1.25rem;
    padding: 1.5rem;
    font-size: 0.9375rem;
    line-height: 1.75;
    color: var(--ink-600);
  }

  .ishraq-shipping__cta {
    margin-top: 2.5rem;
    text-align: center;
  }

  .ishraq-shipping__cta p {
    font-size: 1.0625rem;
    font-weight: 800;
    color: var(--brand-950);
  }

  .ishraq-shipping__cta-actions {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.75rem;
    margin-top: 1rem;
  }

  .btn--whatsapp {
    background: #25d366;
    color: var(--white);
    gap: 0.625rem;
    box-shadow: 0 12px 30px -12px rgba(37, 211, 102, 0.65);
  }

  .btn--whatsapp:hover {
    background: color-mix(in srgb, #25d366 88%, black);
  }

  @media (min-width: 700px) {
    .ishraq-shipping__highlights {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .ishraq-shipping__policies {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (min-width: 1024px) {
    .ishraq-shipping__highlights {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }
  }
{% endstylesheet %}

