{% comment %}
  Ads spend & reports — clone of admin /admin/ads-spend.
  Data stored in browser localStorage. Soft password gate.
{% endcomment %}

{% assign gate_password = section.settings.page_password | default: 'Medafkir@988' %}

<meta name="robots" content="noindex, nofollow">

<section
  class="ishraq-ads full-width"
  dir="ltr"
  id="ishraq-ads"
  data-password="{{ gate_password | escape }}"
>
  <div class="ishraq-ads__gate" id="ishraq-ads-gate" hidden>
    <div class="ishraq-ads__gate-card">
      <p class="ishraq-ads__gate-brand">إشراق · Ishraq</p>
      <h1>Ads spend &amp; reports</h1>
      <p class="ishraq-ads__gate-sub">Private page — enter the access password</p>
      <form id="ishraq-ads-gate-form" class="ishraq-ads__gate-form">
        <label>
          Password
          <input type="password" id="ishraq-ads-password" autocomplete="current-password" required>
        </label>
        <p class="ishraq-ads__gate-error" id="ishraq-ads-gate-error" hidden>Wrong password</p>
        <button type="submit" class="ishraq-ads__btn">Unlock</button>
      </form>
    </div>
  </div>

  <div class="ishraq-ads__app page-width" id="ishraq-ads-app" hidden>
    <header class="ishraq-ads__header">
      <div>
        <p class="ishraq-ads__eyebrow">Ads spend &amp; reports</p>
        <h1>Track ad spend by platform</h1>
        <p class="ishraq-ads__lede">Calculate cost per lead automatically · amounts in MAD</p>
      </div>
      <button type="button" class="ishraq-ads__lockout" id="ishraq-ads-lock">Lock page</button>
    </header>

    <div class="ishraq-ads__toolbar">
      <div class="ishraq-ads__presets" id="ishraq-ads-presets">
        <button type="button" data-preset="today">Today</button>
        <button type="button" data-preset="yesterday">Yesterday</button>
        <button type="button" data-preset="last7" class="is-active">Last 7 Days</button>
        <button type="button" data-preset="thisMonth">This Month</button>
        <button type="button" data-preset="lastMonth">Last Month</button>
        <button type="button" data-preset="all">All Time</button>
      </div>
      <div class="ishraq-ads__dates">
        <label>
          Start date
          <input type="date" id="ishraq-ads-from">
        </label>
        <label>
          End date
          <input type="date" id="ishraq-ads-to">
        </label>
      </div>
    </div>

    <div class="ishraq-ads__actions">
      <p class="ishraq-ads__count" id="ishraq-ads-count">0 spend entries in selected period</p>
      <button type="button" class="ishraq-ads__btn" id="ishraq-ads-add">+ Add spend</button>
    </div>

    <section class="ishraq-ads__kpis">
      <article class="ishraq-ads__kpi ishraq-ads__kpi--purple">
        <p>Total spend</p>
        <strong id="kpi-spend">0 MAD</strong>
        <span id="kpi-spend-helper">0 entries in selected period</span>
      </article>
      <article class="ishraq-ads__kpi ishraq-ads__kpi--green">
        <p>CRM leads</p>
        <strong id="kpi-leads">0</strong>
        <span>Leads entered with spend in this period</span>
      </article>
      <article class="ishraq-ads__kpi ishraq-ads__kpi--amber">
        <p>Cost per lead</p>
        <strong id="kpi-cpl">0,00 MAD</strong>
        <span>Total spend ÷ CRM leads</span>
      </article>
    </section>

    <section class="ishraq-ads__platforms" id="ishraq-ads-platforms"></section>

    <section class="ishraq-ads__table-wrap" id="ishraq-ads-table-wrap" hidden>
      <div class="ishraq-ads__table-head">
        <h3>Daily cost per lead</h3>
        <p>Each spend entry with product-specific leads when a product is selected</p>
      </div>
      <div class="ishraq-ads__table-scroll">
        <table class="ishraq-ads__table">
          <thead>
            <tr>
              <th>Date</th>
              <th>Product</th>
              <th>Platform</th>
              <th>Spend</th>
              <th>Leads</th>
              <th>Cost per lead</th>
              <th></th>
            </tr>
          </thead>
          <tbody id="ishraq-ads-tbody"></tbody>
        </table>
      </div>
    </section>
  </div>

  <div class="ishraq-ads__dialog" id="ishraq-ads-dialog" hidden>
    <div class="ishraq-ads__dialog-backdrop" data-close-dialog></div>
    <div class="ishraq-ads__dialog-card" role="dialog" aria-modal="true" aria-labelledby="ishraq-ads-dialog-title">
      <div class="ishraq-ads__dialog-top">
        <h2 id="ishraq-ads-dialog-title">Add daily ad spend</h2>
        <button type="button" class="ishraq-ads__dialog-x" data-close-dialog aria-label="Close">×</button>
      </div>
      <form id="ishraq-ads-form" class="ishraq-ads__form">
        <label>
          Platform
          <select id="ads-platform" required>
            <option>TikTok Ads</option>
            <option>Facebook Ads</option>
            <option>Google Ads</option>
            <option>Snapchat Ads</option>
          </select>
        </label>
        <label>
          Date
          <input type="date" id="ads-date" required>
        </label>
        <label>
          Product
          <select id="ads-product">
            <option value="">All products</option>
            <option value="collagen-gummies">غوميز الكولاجين</option>
            <option value="melatonin-sleep">ميلاتونين للنوم</option>
          </select>
        </label>
        <label>
          Amount
          <span class="ishraq-ads__field-wrap">
            <input type="number" id="ads-amount" min="0" step="0.01" value="0" required>
            <span class="ishraq-ads__suffix">MAD</span>
          </span>
        </label>
        <label>
          Leads
          <input type="number" id="ads-leads" min="0" step="1" value="0">
        </label>
        <label class="ishraq-ads__form-full">
          Notes
          <input type="text" id="ads-notes" placeholder="Optional">
        </label>
        <p class="ishraq-ads__gate-error" id="ishraq-ads-form-error" hidden></p>
        <div class="ishraq-ads__dialog-actions">
          <button type="button" class="ishraq-ads__btn-ghost" data-close-dialog>Cancel</button>
          <button type="submit" class="ishraq-ads__btn">Save</button>
        </div>
      </form>
    </div>
  </div>
</section>

<script>
  (function () {
    var STORAGE_AUTH = 'ishraq_ads_unlocked';
    var STORAGE_DATA = 'ishraq_ads_entries_v1';
    var PLATFORMS = ['TikTok Ads', 'Facebook Ads', 'Google Ads', 'Snapchat Ads'];
    var PRODUCTS = {
      '': 'All products',
      'collagen-gummies': 'غوميز الكولاجين',
      'melatonin-sleep': 'ميلاتونين للنوم'
    };

    var root = document.getElementById('ishraq-ads');
    var gate = document.getElementById('ishraq-ads-gate');
    var app = document.getElementById('ishraq-ads-app');
    var formGate = document.getElementById('ishraq-ads-gate-form');
    var errorGate = document.getElementById('ishraq-ads-gate-error');
    var expectedPass = (root && root.getAttribute('data-password')) || '';
    var fromEl = document.getElementById('ishraq-ads-from');
    var toEl = document.getElementById('ishraq-ads-to');
    var dialog = document.getElementById('ishraq-ads-dialog');
    var formAdd = document.getElementById('ishraq-ads-form');
    var formError = document.getElementById('ishraq-ads-form-error');

    function pad(n) { return String(n).padStart(2, '0'); }
    function toISO(d) {
      return d.getFullYear() + '-' + pad(d.getMonth() + 1) + '-' + pad(d.getDate());
    }
    function parseISO(s) {
      var p = String(s || '').split('-');
      return new Date(Number(p[0]), Number(p[1]) - 1, Number(p[2]));
    }
    function startOfMonth(d) { return new Date(d.getFullYear(), d.getMonth(), 1); }
    function endOfMonth(d) { return new Date(d.getFullYear(), d.getMonth() + 1, 0); }

    function money(amountMad) {
      return new Intl.NumberFormat('fr-MA', {
        minimumFractionDigits: 0,
        maximumFractionDigits: 2
      }).format(amountMad) + ' MAD';
    }
    function moneyCpl(amountMad) {
      return new Intl.NumberFormat('fr-MA', {
        minimumFractionDigits: 2,
        maximumFractionDigits: 2
      }).format(amountMad) + ' MAD';
    }
    function formatCount(n) {
      return new Intl.NumberFormat('fr-MA', { maximumFractionDigits: 0 }).format(n);
    }

    function showUnlocked(unlocked) {
      if (!gate || !app) return;
      gate.hidden = unlocked;
      app.hidden = !unlocked;
    }
    function isUnlocked() {
      try { return sessionStorage.getItem(STORAGE_AUTH) === '1'; } catch (e) { return false; }
    }

    showUnlocked(isUnlocked());

    if (formGate) {
      formGate.addEventListener('submit', function (e) {
        e.preventDefault();
        var input = document.getElementById('ishraq-ads-password');
        var pass = input ? String(input.value || '') : '';
        if (pass === expectedPass) {
          try { sessionStorage.setItem(STORAGE_AUTH, '1'); } catch (err) {}
          if (errorGate) errorGate.hidden = true;
          showUnlocked(true);
          render();
        } else if (errorGate) {
          errorGate.hidden = false;
        }
      });
    }

    var lockBtn = document.getElementById('ishraq-ads-lock');
    if (lockBtn) {
      lockBtn.addEventListener('click', function () {
        try { sessionStorage.removeItem(STORAGE_AUTH); } catch (e) {}
        showUnlocked(false);
      });
    }

    function loadEntries() {
      try {
        var raw = localStorage.getItem(STORAGE_DATA);
        var parsed = raw ? JSON.parse(raw) : [];
        return Array.isArray(parsed) ? parsed : [];
      } catch (e) {
        return [];
      }
    }
    function saveEntries(entries) {
      try { localStorage.setItem(STORAGE_DATA, JSON.stringify(entries)); } catch (e) {}
    }

    function setPreset(name) {
      var today = new Date();
      today.setHours(0, 0, 0, 0);
      var from = new Date(today);
      var to = new Date(today);

      if (name === 'today') {
        /* keep today */
      } else if (name === 'yesterday') {
        from.setDate(from.getDate() - 1);
        to.setDate(to.getDate() - 1);
      } else if (name === 'last7') {
        from.setDate(from.getDate() - 6);
      } else if (name === 'thisMonth') {
        from = startOfMonth(today);
        to = today;
      } else if (name === 'lastMonth') {
        var prev = new Date(today.getFullYear(), today.getMonth() - 1, 1);
        from = startOfMonth(prev);
        to = endOfMonth(prev);
      } else if (name === 'all') {
        from = new Date(2020, 0, 1);
        to = today;
      }

      fromEl.value = toISO(from);
      toEl.value = toISO(to);
      document.querySelectorAll('#ishraq-ads-presets button').forEach(function (btn) {
        btn.classList.toggle('is-active', btn.getAttribute('data-preset') === name);
      });
      render();
    }

    document.querySelectorAll('#ishraq-ads-presets button').forEach(function (btn) {
      btn.addEventListener('click', function () {
        setPreset(btn.getAttribute('data-preset'));
      });
    });
    if (fromEl) fromEl.addEventListener('change', render);
    if (toEl) toEl.addEventListener('change', render);

    function inRange(dateStr, from, to) {
      return dateStr >= from && dateStr <= to;
    }

    function filteredEntries() {
      var from = fromEl.value || '2020-01-01';
      var to = toEl.value || toISO(new Date());
      return loadEntries().filter(function (e) { return inRange(e.date, from, to); });
    }

    function render() {
      var entries = filteredEntries();
      var totalSpend = 0;
      var totalLeads = 0;
      var byPlatform = {};
      PLATFORMS.forEach(function (p) {
        byPlatform[p] = { spend: 0, leads: 0, entries: 0 };
      });

      entries.forEach(function (e) {
        var spend = Number(e.amountMad) || 0;
        var leads = Number(e.leads) || 0;
        totalSpend += spend;
        totalLeads += leads;
        if (!byPlatform[e.platform]) {
          byPlatform[e.platform] = { spend: 0, leads: 0, entries: 0 };
        }
        byPlatform[e.platform].spend += spend;
        byPlatform[e.platform].leads += leads;
        byPlatform[e.platform].entries += 1;
      });

      var cpl = totalLeads > 0 ? totalSpend / totalLeads : 0;
      var countEl = document.getElementById('ishraq-ads-count');
      if (countEl) {
        countEl.textContent =
          entries.length +
          ' spend ' +
          (entries.length === 1 ? 'entry' : 'entries') +
          ' in selected period';
      }
      document.getElementById('kpi-spend').textContent = money(totalSpend);
      document.getElementById('kpi-spend-helper').textContent =
        entries.length + ' ' + (entries.length === 1 ? 'entry' : 'entries') + ' in selected period';
      document.getElementById('kpi-leads').textContent = formatCount(totalLeads);
      document.getElementById('kpi-cpl').textContent = moneyCpl(cpl);

      var platformsEl = document.getElementById('ishraq-ads-platforms');
      platformsEl.innerHTML = PLATFORMS.map(function (label) {
        var row = byPlatform[label] || { spend: 0, leads: 0, entries: 0 };
        var pCpl = row.leads > 0 ? row.spend / row.leads : 0;
        return (
          '<article class="ishraq-ads__platform">' +
          '<p class="ishraq-ads__platform-name">' + label + '</p>' +
          '<p class="ishraq-ads__platform-spend">' + money(row.spend) + '</p>' +
          '<p class="ishraq-ads__platform-meta">Cost per lead: ' + moneyCpl(pCpl) + '</p>' +
          '<p class="ishraq-ads__platform-meta">' +
          row.entries + ' ' + (row.entries === 1 ? 'spend entry' : 'spend entries') +
          '</p></article>'
        );
      }).join('');

      var withSpend = entries
        .filter(function (e) { return (Number(e.amountMad) || 0) > 0; })
        .slice()
        .sort(function (a, b) { return a.date < b.date ? 1 : a.date > b.date ? -1 : 0; });

      var wrap = document.getElementById('ishraq-ads-table-wrap');
      var tbody = document.getElementById('ishraq-ads-tbody');
      if (!withSpend.length) {
        wrap.hidden = true;
        tbody.innerHTML = '';
        return;
      }
      wrap.hidden = false;
      tbody.innerHTML = withSpend.map(function (e) {
        var spend = Number(e.amountMad) || 0;
        var leads = Number(e.leads) || 0;
        var rowCpl = leads > 0 ? spend / leads : 0;
        var productLabel = PRODUCTS[e.productId] || e.product || 'All products';
        return (
          '<tr>' +
          '<td>' + e.date + '</td>' +
          '<td>' + productLabel + '</td>' +
          '<td><span class="ishraq-ads__badge">' + e.platform + '</span></td>' +
          '<td class="tabular">' + money(spend) + '</td>' +
          '<td class="tabular">' + formatCount(leads) + '</td>' +
          '<td class="tabular ishraq-ads__cpl">' + moneyCpl(rowCpl) + '</td>' +
          '<td><button type="button" class="ishraq-ads__delete" data-id="' + e.id + '">Delete</button></td>' +
          '</tr>'
        );
      }).join('');

      tbody.querySelectorAll('[data-id]').forEach(function (btn) {
        btn.addEventListener('click', function () {
          var id = btn.getAttribute('data-id');
          if (!window.confirm('Delete this spend entry?')) return;
          saveEntries(loadEntries().filter(function (e) { return e.id !== id; }));
          render();
        });
      });
    }

    function openDialog() {
      formError.hidden = true;
      document.getElementById('ads-platform').value = 'TikTok Ads';
      document.getElementById('ads-date').value = toEl.value || toISO(new Date());
      document.getElementById('ads-product').value = '';
      document.getElementById('ads-amount').value = '0';
      document.getElementById('ads-leads').value = '0';
      document.getElementById('ads-notes').value = '';
      dialog.hidden = false;
    }
    function closeDialog() { dialog.hidden = true; }

    document.getElementById('ishraq-ads-add').addEventListener('click', openDialog);
    dialog.querySelectorAll('[data-close-dialog]').forEach(function (el) {
      el.addEventListener('click', closeDialog);
    });

    formAdd.addEventListener('submit', function (e) {
      e.preventDefault();
      var amount = Number(document.getElementById('ads-amount').value) || 0;
      if (amount <= 0) {
        formError.textContent = 'Enter a spend amount greater than 0 MAD.';
        formError.hidden = false;
        return;
      }
      var productId = document.getElementById('ads-product').value;
      var entry = {
        id: 'ads_' + Date.now() + '_' + Math.random().toString(36).slice(2, 7),
        platform: document.getElementById('ads-platform').value,
        productId: productId,
        product: PRODUCTS[productId] || 'All products',
        amountMad: amount,
        date: document.getElementById('ads-date').value,
        leads: Number(document.getElementById('ads-leads').value) || 0,
        notes: String(document.getElementById('ads-notes').value || '').trim()
      };
      var all = loadEntries();
      all.push(entry);
      saveEntries(all);
      closeDialog();
      render();
    });

    setPreset('last7');
    if (isUnlocked()) render();
  })();
</script>

{% stylesheet %}
  .ishraq-ads {
    min-height: 80vh;
    padding-block: 2rem 4rem;
    background: #fcf9f3;
    color: #211b1d;
  }

  .ishraq-ads__gate {
    display: grid;
    place-items: center;
    min-height: 70vh;
    padding: 1.5rem;
  }

  .ishraq-ads__gate[hidden],
  .ishraq-ads__app[hidden],
  .ishraq-ads__dialog[hidden],
  .ishraq-ads__table-wrap[hidden] {
    display: none !important;
  }

  .ishraq-ads__gate-card {
    width: min(100%, 24rem);
    padding: 2rem 1.5rem;
    border-radius: 1.25rem;
    background: #fff;
    border: 1px solid rgba(0, 0, 0, 0.06);
    box-shadow: 0 16px 40px -20px rgba(36, 0, 10, 0.25);
    text-align: center;
  }

  .ishraq-ads__gate-brand {
    font-size: 0.75rem;
    font-weight: 800;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: #590828;
    margin-bottom: 0.75rem;
  }

  .ishraq-ads__gate-card h1 {
    font-size: 1.5rem;
    font-weight: 900;
    color: #24000a;
    margin-bottom: 0.5rem;
  }

  .ishraq-ads__gate-sub {
    font-size: 0.9rem;
    color: #71666a;
    margin-bottom: 1.25rem;
  }

  .ishraq-ads__gate-form { text-align: left; }
  .ishraq-ads__gate-form label,
  .ishraq-ads__form label {
    display: block;
    font-size: 0.75rem;
    font-weight: 800;
    color: #71666a;
  }

  .ishraq-ads__gate-form input,
  .ishraq-ads__form input,
  .ishraq-ads__form select,
  .ishraq-ads__dates input {
    margin-top: 0.4rem;
    width: 100%;
    height: 2.75rem;
    border-radius: 0.75rem;
    border: 1px solid rgba(0, 0, 0, 0.1);
    padding: 0 0.85rem;
    font: inherit;
    background: #fff;
  }

  .ishraq-ads__gate-error {
    margin-top: 0.65rem;
    color: #b91c1c;
    font-size: 0.85rem;
    font-weight: 700;
  }

  .ishraq-ads__btn {
    margin-top: 1rem;
    height: 2.75rem;
    border: 0;
    border-radius: 0.75rem;
    background: #4b2130;
    color: #fff;
    font: inherit;
    font-weight: 800;
    cursor: pointer;
    padding: 0 1.25rem;
  }

  .ishraq-ads__gate-form .ishraq-ads__btn { width: 100%; }
  .ishraq-ads__btn:hover { background: #713149; }

  .ishraq-ads__btn-ghost {
    height: 2.75rem;
    border: 1px solid rgba(0, 0, 0, 0.1);
    border-radius: 0.75rem;
    background: #fff;
    font: inherit;
    font-weight: 700;
    color: #71666a;
    cursor: pointer;
    padding: 0 1.25rem;
  }

  .ishraq-ads__header {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 1rem;
    margin-bottom: 1.25rem;
  }

  .ishraq-ads__eyebrow {
    font-size: 0.75rem;
    font-weight: 800;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    color: #590828;
  }

  .ishraq-ads__header h1 {
    font-size: clamp(1.5rem, 3vw, 2rem);
    font-weight: 900;
    color: #24000a;
    margin: 0.25rem 0;
  }

  .ishraq-ads__lede { color: #71666a; font-size: 0.95rem; }

  .ishraq-ads__lockout {
    border: 1px solid rgba(0, 0, 0, 0.1);
    background: #fff;
    border-radius: 999px;
    padding: 0.5rem 1rem;
    font: inherit;
    font-size: 0.85rem;
    font-weight: 700;
    color: #71666a;
    cursor: pointer;
  }

  .ishraq-ads__toolbar {
    display: grid;
    gap: 0.85rem;
    margin-bottom: 1rem;
  }

  .ishraq-ads__presets {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
  }

  .ishraq-ads__presets button {
    border: 1px solid rgba(0, 0, 0, 0.08);
    background: #fff;
    border-radius: 999px;
    padding: 0.45rem 0.85rem;
    font: inherit;
    font-size: 0.8rem;
    font-weight: 700;
    color: #71666a;
    cursor: pointer;
  }

  .ishraq-ads__presets button.is-active {
    background: #4b2130;
    border-color: #4b2130;
    color: #fff;
  }

  .ishraq-ads__dates {
    display: grid;
    gap: 0.75rem;
    grid-template-columns: 1fr 1fr;
    max-width: 28rem;
  }

  .ishraq-ads__actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
    margin-bottom: 1rem;
  }

  .ishraq-ads__count {
    font-size: 0.9rem;
    font-weight: 700;
    color: #71666a;
  }

  .ishraq-ads__actions .ishraq-ads__btn { margin-top: 0; }

  .ishraq-ads__kpis {
    display: grid;
    gap: 0.75rem;
    margin-bottom: 1rem;
  }

  @media (min-width: 900px) {
    .ishraq-ads__kpis { grid-template-columns: repeat(3, 1fr); }
  }

  .ishraq-ads__kpi {
    border-radius: 1.25rem;
    padding: 1.25rem;
    color: #fff;
    box-shadow: 0 10px 30px -18px rgba(36, 0, 10, 0.3);
  }

  .ishraq-ads__kpi--purple { background: linear-gradient(135deg, #4b2130, #713149); }
  .ishraq-ads__kpi--green { background: linear-gradient(135deg, #1f6b43, #28704a); }
  .ishraq-ads__kpi--amber {
    background: linear-gradient(135deg, #a87838, #d8b77a);
    color: #321520;
  }

  .ishraq-ads__kpi p {
    font-size: 0.7rem;
    font-weight: 800;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    opacity: 0.9;
  }

  .ishraq-ads__kpi strong {
    display: block;
    margin-top: 0.5rem;
    font-size: clamp(1.5rem, 3vw, 1.875rem);
    font-weight: 900;
    font-variant-numeric: tabular-nums;
  }

  .ishraq-ads__kpi span {
    display: block;
    margin-top: 0.5rem;
    font-size: 0.75rem;
    font-weight: 600;
    opacity: 0.9;
  }

  .ishraq-ads__platforms {
    display: grid;
    gap: 0.75rem;
    margin-bottom: 1.25rem;
  }

  @media (min-width: 640px) {
    .ishraq-ads__platforms { grid-template-columns: repeat(2, 1fr); }
  }
  @media (min-width: 1100px) {
    .ishraq-ads__platforms { grid-template-columns: repeat(4, 1fr); }
  }

  .ishraq-ads__platform {
    background: #fff;
    border: 1px solid rgba(0, 0, 0, 0.05);
    border-radius: 1.25rem;
    padding: 1rem;
    box-shadow: 0 8px 24px -16px rgba(36, 0, 10, 0.2);
  }

  .ishraq-ads__platform-name {
    font-size: 0.9rem;
    font-weight: 800;
    color: #321520;
  }

  .ishraq-ads__platform-spend {
    margin-top: 0.75rem;
    font-size: 1.5rem;
    font-weight: 900;
    color: #321520;
    font-variant-numeric: tabular-nums;
  }

  .ishraq-ads__platform-meta {
    margin-top: 0.4rem;
    font-size: 0.75rem;
    font-weight: 600;
    color: #857b7e;
  }

  .ishraq-ads__table-wrap {
    overflow: hidden;
    border-radius: 1.25rem;
    border: 1px solid rgba(0, 0, 0, 0.05);
    background: #fff;
    box-shadow: 0 8px 24px -16px rgba(36, 0, 10, 0.2);
  }

  .ishraq-ads__table-head {
    border-bottom: 1px solid rgba(0, 0, 0, 0.05);
    padding: 0.85rem 1rem;
  }

  .ishraq-ads__table-head h3 {
    font-size: 0.9rem;
    font-weight: 800;
    color: #321520;
  }

  .ishraq-ads__table-head p {
    margin-top: 0.2rem;
    font-size: 0.75rem;
    color: #857b7e;
  }

  .ishraq-ads__table-scroll { overflow-x: auto; }

  .ishraq-ads__table {
    width: 100%;
    min-width: 760px;
    border-collapse: collapse;
    text-align: left;
    font-size: 0.9rem;
  }

  .ishraq-ads__table th {
    background: #faf9f7;
    color: #71666a;
    font-size: 0.75rem;
    font-weight: 800;
    padding: 0.75rem 1rem;
  }

  .ishraq-ads__table td {
    border-top: 1px solid rgba(0, 0, 0, 0.05);
    padding: 0.75rem 1rem;
    font-weight: 600;
  }

  .ishraq-ads__table .tabular {
    font-weight: 800;
    font-variant-numeric: tabular-nums;
  }

  .ishraq-ads__cpl { color: #713149; }

  .ishraq-ads__badge {
    display: inline-block;
    padding: 0.2rem 0.55rem;
    border-radius: 999px;
    background: color-mix(in srgb, #d8b77a 35%, white);
    color: #4b2130;
    font-size: 0.75rem;
    font-weight: 800;
  }

  .ishraq-ads__delete {
    border: 0;
    background: transparent;
    color: #b91c1c;
    font: inherit;
    font-size: 0.8rem;
    font-weight: 700;
    cursor: pointer;
  }

  .ishraq-ads__dialog {
    position: fixed;
    inset: 0;
    z-index: 80;
    display: grid;
    place-items: center;
    padding: 1rem;
  }

  .ishraq-ads__dialog-backdrop {
    position: absolute;
    inset: 0;
    background: rgba(36, 0, 10, 0.45);
  }

  .ishraq-ads__dialog-card {
    position: relative;
    z-index: 1;
    width: min(100%, 36rem);
    max-height: 90vh;
    overflow: auto;
    background: #fff;
    border-radius: 1.25rem;
    padding: 1.25rem;
    box-shadow: 0 24px 60px -20px rgba(36, 0, 10, 0.4);
  }

  .ishraq-ads__dialog-top {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 1rem;
  }

  .ishraq-ads__dialog-top h2 {
    font-size: 1.125rem;
    font-weight: 900;
    color: #24000a;
  }

  .ishraq-ads__dialog-x {
    border: 0;
    background: transparent;
    font-size: 1.5rem;
    line-height: 1;
    cursor: pointer;
    color: #71666a;
  }

  .ishraq-ads__form {
    display: grid;
    gap: 0.85rem;
  }

  @media (min-width: 640px) {
    .ishraq-ads__form { grid-template-columns: 1fr 1fr; }
    .ishraq-ads__form-full,
    .ishraq-ads__dialog-actions { grid-column: 1 / -1; }
  }

  .ishraq-ads__field-wrap { position: relative; display: block; }
  .ishraq-ads__field-wrap input { padding-inline-end: 3.25rem; }
  .ishraq-ads__suffix {
    position: absolute;
    inset-inline-end: 0.75rem;
    top: 50%;
    transform: translateY(-35%);
    font-size: 0.75rem;
    font-weight: 700;
    color: #71666a;
    pointer-events: none;
  }

  .ishraq-ads__dialog-actions {
    display: flex;
    justify-content: flex-end;
    gap: 0.65rem;
    margin-top: 0.5rem;
  }

  .ishraq-ads__dialog-actions .ishraq-ads__btn { margin-top: 0; }
{% endstylesheet %}

