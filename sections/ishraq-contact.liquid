{% comment %}
  Ishraq contact page — info cards, WhatsApp CTA, optional form.
{% endcomment %}

{% liquid
  assign whatsapp_digits = section.settings.whatsapp_number | replace: ' ', '' | replace: '-', '' | replace: '+', '' | replace: '(', '' | replace: ')', ''
  assign whatsapp_message = section.settings.whatsapp_message | url_encode
  assign whatsapp_url = 'https://wa.me/' | append: whatsapp_digits
  if section.settings.whatsapp_message != blank
    assign whatsapp_url = whatsapp_url | append: '?text=' | append: whatsapp_message
  endif
  assign phone_display = section.settings.phone_display | default: section.settings.whatsapp_number
  assign phone_href = section.settings.phone_number | default: section.settings.whatsapp_number | replace: ' ', '' | replace: '-', ''
%}

<section class="ishraq-contact full-width">
  <div class="ishraq-contact__hero page-width">
    <h1>{{ section.settings.label | default: 'تواصل معنا' }}</h1>
    <p class="ishraq-contact__lead">
      {{ section.settings.lead | default: 'فريق إشراق جاهز يجاوبك على أسئلة المنتجات، الطلب، والتوصيل. أسرع طريقة: واتساب — أو خلّي لينا رسالة ونعاودو ليك.' }}
    </p>

    {% if whatsapp_digits != blank %}
      <div class="ishraq-contact__hero-actions">
        <a
          href="{{ whatsapp_url }}"
          class="btn btn--whatsapp btn--lg ishraq-contact__whatsapp-btn"
          target="_blank"
          rel="noopener noreferrer"
        >
          <svg class="ishraq-contact__wa-icon" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
            <path fill="currentColor" d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 0 1-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 0 1-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 0 1 2.893 6.994c-.003 5.45-4.435 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0 0 12.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 0 0 5.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 0 0-3.48-8.413z"/>
          </svg>
          {{ section.settings.whatsapp_label | default: 'راسلونا على واتساب' }}
        </a>
        {% if phone_href != blank %}
          <a href="tel:{{ phone_href }}" class="btn btn--secondary btn--lg">
            {{ section.settings.phone_label | default: 'اتصلي بنا' }}
          </a>
        {% endif %}
      </div>
    {% endif %}
  </div>

  <div class="ishraq-contact__grid page-width{% if section.settings.show_form %} ishraq-contact__grid--with-form{% endif %}">
    <div class="ishraq-contact__info">
      <div class="ishraq-contact__cards">
        {% if whatsapp_digits != blank %}
          <a href="{{ whatsapp_url }}" class="ishraq-contact__card card ishraq-contact__card--whatsapp" target="_blank" rel="noopener noreferrer">
            <span class="ishraq-contact__card-icon" aria-hidden="true">💬</span>
            <div>
              <h2>واتساب</h2>
              <p>{{ section.settings.whatsapp_card_text | default: 'رد سريع على أسئلة المنتجات والطلبات.' }}</p>
              {% if phone_display != blank %}
                <strong dir="ltr">{{ phone_display }}</strong>
              {% endif %}
            </div>
          </a>
        {% endif %}

        {% if section.settings.email != blank %}
          <a href="mailto:{{ section.settings.email }}" class="ishraq-contact__card card">
            <span class="ishraq-contact__card-icon" aria-hidden="true">✉️</span>
            <div>
              <h2>البريد الإلكتروني</h2>
              <p>{{ section.settings.email_card_text | default: 'للاستفسارات التفصيلية أو الشراكات.' }}</p>
              <strong dir="ltr">{{ section.settings.email }}</strong>
            </div>
          </a>
        {% endif %}

        <div class="ishraq-contact__card card">
          <span class="ishraq-contact__card-icon" aria-hidden="true">🕐</span>
          <div>
            <h2>{{ section.settings.hours_title | default: 'أوقات الرد' }}</h2>
            <p>{{ section.settings.hours_body | default: 'من الإثنين للسبت · 10:00 – 19:00 (توقيت المغرب)' }}</p>
          </div>
        </div>

        <div class="ishraq-contact__card card">
          <span class="ishraq-contact__card-icon" aria-hidden="true">📦</span>
          <div>
            <h2>{{ section.settings.cod_title | default: 'الطلب والتوصيل' }}</h2>
            <p>{{ section.settings.cod_body | default: 'أداء عند الاستلام + تأكيد هاتفي قبل الإرسال — باش تكوني مطمئنة.' }}</p>
          </div>
        </div>
      </div>

      {% if page.content != blank %}
        <div class="ishraq-contact__page-content rte card">
          {{ page.content }}
        </div>
      {% endif %}
    </div>

    {% if section.settings.show_form %}
      <div class="ishraq-contact__form-wrap card">
        <h2>{{ section.settings.form_heading | default: 'أرسلي لنا رسالة' }}</h2>
        <p class="ishraq-contact__form-lead">{{ section.settings.form_lead | default: 'املئي النموذج ونعاودو ليك في أقرب وقت.' }}</p>

        {% form 'contact', class: 'ishraq-contact__form' %}
          {% if form.posted_successfully? %}
            <p class="ishraq-contact__notice ishraq-contact__notice--success" role="status">
              {{ section.settings.form_success | default: 'شكراً! وصلت رسالتك — غادي نتواصلو معاك قريباً.' }}
            </p>
          {% endif %}

          {% if form.errors %}
            <div class="ishraq-contact__notice ishraq-contact__notice--error" role="alert">
              {{ form.errors | default_errors }}
            </div>
          {% endif %}

          <div class="ishraq-contact__field">
            <label for="ContactForm-name">{{ section.settings.name_label | default: 'الاسم' }}</label>
            <input
              type="text"
              id="ContactForm-name"
              name="contact[name]"
              value="{% if form.name %}{{ form.name }}{% elsif customer %}{{ customer.name }}{% endif %}"
              autocomplete="name"
              required
            >
          </div>

          <div class="ishraq-contact__field">
            <label for="ContactForm-email">{{ section.settings.email_label | default: 'البريد الإلكتروني' }}</label>
            <input
              type="email"
              id="ContactForm-email"
              name="contact[email]"
              value="{% if form.email %}{{ form.email }}{% elsif customer %}{{ customer.email }}{% endif %}"
              autocomplete="email"
              spellcheck="false"
              required
            >
          </div>

          <div class="ishraq-contact__field">
            <label for="ContactForm-phone">{{ section.settings.phone_form_label | default: 'الهاتف (اختياري)' }}</label>
            <input
              type="tel"
              id="ContactForm-phone"
              name="contact[phone]"
              value="{% if form.phone %}{{ form.phone }}{% endif %}"
              autocomplete="tel"
              dir="ltr"
            >
          </div>

          <div class="ishraq-contact__field">
            <label for="ContactForm-body">{{ section.settings.message_label | default: 'رسالتك' }}</label>
            <textarea
              id="ContactForm-body"
              name="contact[body]"
              rows="5"
              required
            >{% if form.body %}{{ form.body }}{% endif %}</textarea>
          </div>

          <button type="submit" class="btn btn--primary btn--lg ishraq-contact__submit">
            {{ section.settings.submit_label | default: 'إرسال الرسالة' }}
          </button>
        {% endform %}
      </div>
    {% endif %}
  </div>
</section>

{% if whatsapp_digits != blank and section.settings.show_floating_whatsapp %}
  <a
    href="{{ whatsapp_url }}"
    class="ishraq-contact__fab"
    target="_blank"
    rel="noopener noreferrer"
    aria-label="{{ section.settings.whatsapp_label | default: 'راسلونا على واتساب' }}"
  >
    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
      <path fill="currentColor" d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 0 1-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 0 1-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 0 1 2.893 6.994c-.003 5.45-4.435 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0 0 12.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 0 0 5.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 0 0-3.48-8.413z"/>
    </svg>
  </a>
{% endif %}

{% stylesheet %}
  .ishraq-contact {
    padding-block: 2.5rem 4rem;
  }

  .ishraq-contact__hero {
    max-width: 42rem;
    margin-inline: auto;
    margin-bottom: 2.5rem;
    text-align: center;
  }

  .ishraq-contact__hero h1 {
    font-size: clamp(1.875rem, 5vw, 2.5rem);
    font-weight: 900;
    color: var(--brand-950);
  }

  .ishraq-contact__lead {
    margin-top: 0.75rem;
    font-size: 1.0625rem;
    line-height: 1.8;
    color: var(--ink-600);
  }

  .ishraq-contact__hero-actions {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.75rem;
    margin-top: 1.75rem;
  }

  .btn--whatsapp {
    background: #25d366;
    color: var(--white);
    gap: 0.625rem;
    box-shadow: 0 12px 30px -12px rgba(37, 211, 102, 0.65);
  }

  .btn--whatsapp:hover {
    background: color-mix(in srgb, #25d366 88%, black);
  }

  .ishraq-contact__wa-icon {
    width: 1.35rem;
    height: 1.35rem;
    flex-shrink: 0;
  }

  .ishraq-contact__grid {
    display: grid;
    gap: 1.5rem;
    align-items: start;
  }

  .ishraq-contact__cards {
    display: grid;
    gap: 1rem;
  }

  .ishraq-contact__card {
    display: flex;
    gap: 1rem;
    padding: 1.25rem;
    text-decoration: none;
    color: inherit;
    transition: transform 0.2s, box-shadow 0.2s, border-color 0.2s;
  }

  a.ishraq-contact__card:hover {
    transform: translateY(-2px);
    box-shadow: var(--shadow-soft);
    border-color: color-mix(in srgb, var(--brand-800) 18%, transparent);
  }

  .ishraq-contact__card--whatsapp {
    border-color: color-mix(in srgb, #25d366 25%, transparent);
    background: color-mix(in srgb, #25d366 6%, var(--white));
  }

  .ishraq-contact__card-icon {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 2.75rem;
    height: 2.75rem;
    flex-shrink: 0;
    border-radius: 0.875rem;
    background: color-mix(in srgb, var(--brand-800) 8%, transparent);
    font-size: 1.25rem;
  }

  .ishraq-contact__card h2 {
    font-size: 1rem;
    color: var(--brand-950);
  }

  .ishraq-contact__card p {
    margin-top: 0.35rem;
    font-size: 0.875rem;
    line-height: 1.65;
    color: var(--ink-600);
  }

  .ishraq-contact__card strong {
    display: inline-block;
    margin-top: 0.5rem;
    font-size: 0.9375rem;
    color: var(--brand-800);
  }

  .ishraq-contact__page-content {
    margin-top: 1rem;
    padding: 1.25rem;
    font-size: 0.9375rem;
    line-height: 1.75;
    color: var(--ink-600);
  }

  .ishraq-contact__form-wrap {
    padding: 1.5rem;
  }

  .ishraq-contact__form-wrap h2 {
    font-size: 1.25rem;
    color: var(--brand-950);
  }

  .ishraq-contact__form-lead {
    margin-top: 0.5rem;
    font-size: 0.9375rem;
    color: var(--ink-600);
  }

  .ishraq-contact__form {
    display: grid;
    gap: 1rem;
    margin-top: 1.25rem;
  }

  .ishraq-contact__field label {
    display: block;
    margin-bottom: 0.35rem;
    font-size: 0.875rem;
    font-weight: 700;
    color: var(--brand-950);
  }

  .ishraq-contact__field input,
  .ishraq-contact__field textarea {
    width: 100%;
    padding: 0.75rem 0.875rem;
    border: 1px solid color-mix(in srgb, var(--brand-800) 12%, transparent);
    border-radius: 0.75rem;
    background: var(--white);
    font: inherit;
    color: var(--ink-950);
  }

  .ishraq-contact__field input:focus,
  .ishraq-contact__field textarea:focus {
    outline: 2px solid color-mix(in srgb, var(--brass-600) 35%, transparent);
    outline-offset: 1px;
    border-color: color-mix(in srgb, var(--brass-600) 40%, transparent);
  }

  .ishraq-contact__submit {
    width: 100%;
    margin-top: 0.25rem;
  }

  .ishraq-contact__notice {
    padding: 0.875rem 1rem;
    border-radius: 0.75rem;
    font-size: 0.875rem;
    line-height: 1.6;
  }

  .ishraq-contact__notice--success {
    background: color-mix(in srgb, var(--success-700) 10%, var(--white));
    color: var(--success-700);
    border: 1px solid color-mix(in srgb, var(--success-700) 20%, transparent);
  }

  .ishraq-contact__notice--error {
    background: color-mix(in srgb, var(--danger-700) 8%, var(--white));
    color: var(--danger-700);
    border: 1px solid color-mix(in srgb, var(--danger-700) 18%, transparent);
  }

  .ishraq-contact__fab {
    position: fixed;
    z-index: 40;
    bottom: 1.25rem;
    left: 1.25rem;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 3.5rem;
    height: 3.5rem;
    border-radius: 9999px;
    background: #25d366;
    color: var(--white);
    box-shadow: 0 14px 34px -10px rgba(37, 211, 102, 0.75);
    transition: transform 0.2s, background 0.2s;
  }

  .ishraq-contact__fab:hover {
    transform: scale(1.05);
    background: color-mix(in srgb, #25d366 88%, black);
  }

  .ishraq-contact__fab svg {
    width: 1.75rem;
    height: 1.75rem;
  }

  @media (min-width: 900px) {
    .ishraq-contact__grid--with-form {
      grid-template-columns: minmax(0, 1fr) minmax(18rem, 22rem);
    }

    .ishraq-contact__cards {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (min-width: 1100px) {
    .ishraq-contact__grid--with-form {
      grid-template-columns: minmax(0, 1.15fr) minmax(20rem, 24rem);
      gap: 2rem;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Ishraq Contact",
  "settings": [
    {
      "type": "header",
      "content": "Hero"
    },
    {
      "type": "text",
      "id": "label",
      "label": "Eyebrow label",
      "default": "تواصل معنا"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading fallback",
      "default": "تواصل معنا"
    },
    {
      "type": "textarea",
      "id": "lead",
      "label": "Intro text",
      "default": "فريق إشراق جاهز يجاوبك على أسئلة المنتجات، الطلب، والتوصيل. أسرع طريقة: واتساب — أو خلّي لينا رسالة ونعاودو ليك."
    },
    {
      "type": "header",
      "content": "WhatsApp"
    },
    {
      "type": "text",
      "id": "whatsapp_number",
