<div
  id="ishraq-cart-drawer"
  class="ishraq-cart-drawer"
  aria-hidden="true"
  data-cart-drawer
>
  <div class="ishraq-cart-drawer__overlay" data-cart-drawer-close tabindex="-1"></div>

  <aside
    class="ishraq-cart-drawer__panel"
    role="dialog"
    aria-modal="true"
    aria-labelledby="ishraq-cart-drawer-title"
    tabindex="-1"
  >
    <header class="ishraq-cart-drawer__header">
      <h2 id="ishraq-cart-drawer-title" class="ishraq-cart-drawer__title">سلتك</h2>
      <button type="button" class="ishraq-cart-drawer__close" data-cart-drawer-close aria-label="إغلاق">
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="none" aria-hidden="true">
          <path stroke="currentColor" stroke-linecap="round" stroke-width="1.75" d="M5 5l10 10M15 5 5 15"/>
        </svg>
      </button>
    </header>

    <div class="ishraq-cart-drawer__body" data-cart-drawer-contents>
      <p class="ishraq-cart-drawer__loading">جاري التحميل...</p>
    </div>

    <footer class="ishraq-cart-drawer__footer" data-cart-drawer-footer hidden>
      <div class="ishraq-cart-drawer__total">
        <span>المجموع</span>
        <strong data-cart-drawer-total></strong>
      </div>
      <p class="ishraq-cart-drawer__note">تأكيد بالهاتف قبل الإرسال · الأداء عند الاستلام</p>
      <a href="/checkout" class="btn btn--primary btn--lg ishraq-cart-drawer__checkout" data-cart-drawer-checkout>
        كمّلي الطلب
      </a>
    </footer>
  </aside>
</div>

<script>
  window.IshraqCart = {
    moneyFormat: {{ shop.money_format | json }},
    currency: {{ cart.currency.iso_code | json }},
    collectionUrl: {{ routes.all_products_collection_url | json }}
  };
</script>
<script src="{{ 'cart-drawer.js' | asset_url }}" defer></script>

<style>
  .ishraq-cart-drawer {
    position: fixed;
    inset: 0;
    z-index: 60;
    pointer-events: none;
  }

  .ishraq-cart-drawer.is-open {
    pointer-events: auto;
  }

  .ishraq-cart-drawer__overlay {
    position: absolute;
    inset: 0;
    background: color-mix(in srgb, var(--ink-950) 42%, transparent);
    opacity: 0;
    transition: opacity 0.28s ease;
  }

  .ishraq-cart-drawer.is-open .ishraq-cart-drawer__overlay {
    opacity: 1;
  }

  .ishraq-cart-drawer__panel {
    position: absolute;
    top: 0;
    right: 0;
    display: flex;
    flex-direction: column;
    width: min(100%, 24rem);
    height: 100%;
    background: var(--ivory-50);
    box-shadow: -12px 0 40px color-mix(in srgb, var(--brand-950) 18%, transparent);
    transform: translateX(100%);
    transition: transform 0.32s cubic-bezier(0.22, 1, 0.36, 1);
    direction: rtl;
  }

  .ishraq-cart-drawer.is-open .ishraq-cart-drawer__panel {
    transform: translateX(0);
  }

  .ishraq-cart-drawer__header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding: 1rem 1rem 1rem 1.25rem;
    border-bottom: 1px solid color-mix(in srgb, var(--brand-800) 10%, transparent);
  }

  .ishraq-cart-drawer__title {
    margin: 0;
    font-size: 1.125rem;
    font-weight: 800;
    color: var(--brand-950);
  }

  .ishraq-cart-drawer__close {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2.5rem;
    height: 2.5rem;
    border: 1px solid color-mix(in srgb, var(--brand-800) 12%, transparent);
    border-radius: 0.75rem;
    background: var(--white);
    color: var(--ink-600);
    cursor: pointer;
  }

  .ishraq-cart-drawer__close svg {
    width: 1rem;
    height: 1rem;
  }

  .ishraq-cart-drawer__body {
    flex: 1;
    overflow-y: auto;
    padding: 1rem 1.25rem;
  }

  .ishraq-cart-drawer__loading,
  .ishraq-cart-drawer__empty {
    margin: 2rem 0;
    text-align: center;
    color: var(--ink-600);
    font-weight: 700;
  }

  .ishraq-cart-drawer__shop {
    display: flex;
    width: 100%;
    justify-content: center;
    margin-top: 1rem;
  }

  .ishraq-cart-drawer__list {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .ishraq-cart-drawer__item {
    display: grid;
    grid-template-columns: 4rem 1fr auto;
    gap: 0.75rem;
    align-items: start;
    padding: 0.875rem;
    border: 1px solid color-mix(in srgb, var(--brand-800) 10%, transparent);
    border-radius: 1rem;
    background: var(--white);
  }

  .ishraq-cart-drawer__item img {
    width: 4rem;
    height: 4rem;
    border-radius: 0.75rem;
    object-fit: cover;
  }

  .ishraq-cart-drawer__item-title {
    margin: 0 0 0.25rem;
    font-size: 0.9375rem;
    font-weight: 800;
    color: var(--ink-950);
  }

  .ishraq-cart-drawer__item-meta {
    margin: 0;
    font-size: 0.8125rem;
    color: var(--ink-600);
    font-weight: 700;
  }

  .ishraq-cart-drawer__remove {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2.25rem;
    height: 2.25rem;
    border: 1px solid color-mix(in srgb, #9b2c2c 18%, transparent);
    border-radius: 0.625rem;
    background: color-mix(in srgb, #9b2c2c 6%, white);
    color: #9b2c2c;
    cursor: pointer;
    padding: 0;
    transition: background 0.2s ease, border-color 0.2s ease, color 0.2s ease;
  }

  .ishraq-cart-drawer__remove:hover {
    background: color-mix(in srgb, #9b2c2c 12%, white);
    border-color: color-mix(in srgb, #9b2c2c 35%, transparent);
  }

  .ishraq-cart-drawer__remove:disabled {
    opacity: 0.5;
    cursor: not-allowed;
  }

  .ishraq-cart-drawer__remove-icon {
    width: 1rem;
    height: 1rem;
  }

  .ishraq-cart-drawer__footer {
    padding: 1rem 1.25rem 1.25rem;
    border-top: 1px solid color-mix(in srgb, var(--brand-800) 10%, transparent);
    background: color-mix(in srgb, var(--ivory-50) 92%, white);
  }

  .ishraq-cart-drawer__total {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 0.5rem;
    font-size: 0.9375rem;
    font-weight: 700;
  }

  .ishraq-cart-drawer__total strong {
    font-size: 1.0625rem;
    font-weight: 900;
    color: var(--brand-950);
    font-variant-numeric: tabular-nums;
  }

  .ishraq-cart-drawer__note {
    margin: 0 0 0.875rem;
    font-size: 0.75rem;
    color: var(--ink-600);
    font-weight: 700;
  }

  .ishraq-cart-drawer__checkout {
    display: flex;
    width: 100%;
    justify-content: center;
    text-decoration: none;
  }

  @media (prefers-reduced-motion: reduce) {
    .ishraq-cart-drawer__panel,
    .ishraq-cart-drawer__overlay {
      transition: none;
    }
  }
</style>
