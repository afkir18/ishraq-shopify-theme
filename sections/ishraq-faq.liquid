    },
    {
      "type": "header",
      "content": "WhatsApp"
    },
    {
      "type": "text",
      "id": "whatsapp_number",
      "label": "WhatsApp number",
      "default": "212708257675"
    },
    {
      "type": "text",
      "id": "whatsapp_message",
      "label": "Prefilled WhatsApp message",
      "default": "مرحبا إشراق، عندي سؤال."
    },
    {
      "type": "text",
      "id": "whatsapp_label",
      "label": "WhatsApp button",
      "default": "واتساب إشراق"
    },
    {
      "type": "text",
      "id": "contact_label",
      "label": "Contact button",
      "default": "تواصل معنا"
    },
    {
      "type": "text",
      "id": "shipping_label",
      "label": "Shipping button",
      "default": "التوصيل والإرجاع"
    },
    {
      "type": "text",
      "id": "cta_text",
      "label": "CTA text",
      "default": "ما لقيتيش جوابك؟"
    }
  ],
  "blocks": [
    {
      "type": "item",
      "name": "سؤال",
      "settings": [
        {
          "type": "text",
          "id": "question",
          "label": "Question"
        },
        {
          "type": "textarea",
          "id": "answer",
          "label": "Answer"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Ishraq FAQ"
    }
  ]
}
{% endschema %}
