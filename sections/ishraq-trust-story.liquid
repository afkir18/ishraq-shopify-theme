<section class="ishraq-trust-story full-width">
  <div class="ishraq-trust-story__grid page-width">
    <div class="ishraq-trust-story__media">
      {% if section.settings.image != blank %}
        {{ section.settings.image | image_url: width: 800 | image_tag: loading: 'lazy', alt: section.settings.image.alt }}
      {% else %}
        <img src="{{ 'home-trust.jpg' | asset_url }}" alt="معايير الثقة — إشراق" width="720" height="900" loading="lazy">
      {% endif %}
    </div>
    <div>
      <p class="section-label">{{ section.settings.label | default: "علاش الثقة مهمة" }}</p>
      <h2>{{ section.settings.heading | default: "فالمغرب، الثقة هي اللي كتبيع — مشي الوعود الفاضية." }}</h2>
      <p class="ishraq-trust-story__lead">
        {{ section.settings.lead | default: "بزاف ديال الناس كيشريو مكملات بلا ما يعرفو الشكون كيبيع، واش التركيبة واضحة، ولا شنو يتوقّاو. إشراق جا باش يعطي نفس الإحساس ديال الكاونتر المحترم — online." }}
      </p>
      <ul class="ishraq-trust-story__list">
        {% for block in section.blocks %}
          <li {{ block.shopify_attributes }}>{{ block.settings.text }}</li>
        {% endfor %}
      </ul>
    </div>
  </div>
</section>

{% stylesheet %}
  .ishraq-trust-story {
    background: var(--ivory-100);
    padding-block: 4rem 5rem;
  }

  .ishraq-trust-story__grid {
    display: grid;
    gap: 2.5rem;
    align-items: center;
  }

  .ishraq-trust-story__media {
    overflow: hidden;
    border-radius: 1.75rem;
    box-shadow: var(--shadow-soft);
  }

  .ishraq-trust-story__media img {
    width: 100%;
    aspect-ratio: 4 / 5;
    object-fit: cover;
  }

  .ishraq-trust-story h2 {
    font-size: clamp(1.875rem, 4vw, 2.25rem);
    line-height: 1.25;
    color: var(--brand-950);
  }

  .ishraq-trust-story__lead {
    margin-top: 1rem;
    color: var(--ink-600);
  }

  .ishraq-trust-story__list {
    margin-top: 2rem;
    padding: 0;
    list-style: none;
  }

  .ishraq-trust-story__list li {
    display: flex;
    gap: 0.75rem;
    align-items: flex-start;
    font-size: 0.9375rem;
    color: var(--ink-950);
  }

  .ishraq-trust-story__list li + li {
    margin-top: 1rem;
  }

  .ishraq-trust-story__list li::before {
    content: "✓";
    display: flex;
    align-items: center;
    justify-content: center;
    width: 1.5rem;
    height: 1.5rem;
    flex-shrink: 0;
    margin-top: 0.125rem;
    border-radius: 9999px;
    background: color-mix(in srgb, var(--success-700) 10%, transparent);
    font-size: 0.75rem;
    font-weight: 900;
    color: var(--success-700);
  }

  @media (min-width: 768px) {
    .ishraq-trust-story__grid {
      grid-template-columns: 1fr 1fr;
      gap: 3.5rem;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Ishraq Trust Story",
  "settings": [
    { "type": "text", "id": "label", "label": "Section label" },
    { "type": "text", "id": "heading", "label": "Heading" },
    { "type": "textarea", "id": "lead", "label": "Lead" },
    { "type": "image_picker", "id": "image", "label": "Image" }
  ],
  "blocks": [
    {
      "type": "point",
      "name": "Point",
      "settings": [{ "type": "text", "id": "text", "label": "Text" }]
    }
  ],
  "presets": [
    {
      "name": "Ishraq Trust Story",
      "blocks": [
        { "type": "point", "settings": { "text": "ملصق ومكوّن مفهومين قبل ما تشري." } },
        { "type": "point", "settings": { "text": "ما كنعدّوش المكمل علاج — كنشرحو الروتين بصدق." } },
        { "type": "point", "settings": { "text": "COD + تأكيد هاتفي — باش ما تبقيش فالشك." } }
      ]
    }
  ]
}
{% endschema %}
