<section class="ishraq-hero full-width">
  <div class="ishraq-hero__bg"></div>
  <div class="ishraq-hero__grid page-width">
    <div class="ishraq-hero__content">
      <p class="ishraq-hero__badge">
        <span aria-hidden="true">🇲🇦</span>
        {{ section.settings.badge | default: "دار مغربية للعناية والجمال" }}
      </p>
      <h1>
        {{ section.settings.heading_line_1 | default: "جمالك. صحتك." }}
        <br>
        <span class="ishraq-hero__accent">{{ section.settings.heading_line_2 | default: "من إشراق." }}</span>
      </h1>
      <p class="ishraq-hero__lead">
        {{ section.settings.lead | default: "إشراق — دار مغربية للعناية بالبشرة، الشعر، والمكملات الغذائية. غوميز لذيذة، روتين يومي واضح، وتركيبة مفهومة — مع الأداء عند الاستلام وتأكيد قبل الإرسال." }}
      </p>

      <div class="ishraq-hero__proof">
        {% if section.settings.rating != blank %}
          <span class="ishraq-hero__stars">
            <span class="ishraq-hero__stars-icons">★★★★★</span>
            {{ section.settings.rating }}
            {% if section.settings.review_count != blank %}
              <span class="ishraq-hero__review-count">({{ section.settings.review_count }} تقييم)</span>
            {% endif %}
          </span>
        {% endif %}
        {% if section.settings.orders_count != blank %}
          <span class="ishraq-hero__orders">+{{ section.settings.orders_count }} طلب مكتمل</span>
        {% endif %}
      </div>

      <div class="ishraq-hero__badges">
        {% if section.settings.show_onssa %}<span class="ishraq-hero__trust-chip">✓ متوافق مع ONSSA</span>{% endif %}
        {% if section.settings.show_lab %}<span class="ishraq-hero__trust-chip">🔬 مختبر معملياً</span>{% endif %}
        {% if section.settings.show_halal %}<span class="ishraq-hero__trust-chip">حلال 100%</span>{% endif %}
      </div>

      <div class="ishraq-hero__actions">
        <a href="{{ section.settings.cta_link | default: routes.all_products_collection_url }}" class="ishraq-hero__cta-btn">
          <span>{{ section.settings.cta_label | default: "بداي روتينك دابا" }}</span>
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
        </a>
      </div>

      <div class="ishraq-hero__micro-trust">
        <span>💳 دفع عند الاستلام</span>
        <span>🚚 شحن مجاني</span>
      </div>
    </div>

    <div class="ishraq-hero__media">
      <div class="ishraq-hero__image-wrap">
        {% if section.settings.image != blank %}
          {{ section.settings.image | image_url: width: 900 | image_tag: loading: 'eager', alt: section.settings.image.alt | default: shop.name }}
        {% else %}
          <img src="{{ 'home-hero.png' | asset_url }}" alt="إشراق — عناية بالبشرة والشعر والمكملات" width="830" height="830" loading="eager">
        {% endif %}
      </div>
    </div>
  </div>

  <div class="ishraq-hero__counters page-width">
    {% for block in section.blocks %}
      <div class="ishraq-hero__counter" {{ block.shopify_attributes }}>
        <strong>{{ block.settings.value }}</strong>
        <span>{{ block.settings.label }}</span>
      </div>
    {% endfor %}
  </div>
</section>

{% stylesheet %}
  .ishraq-hero {
    position: relative;
    overflow: hidden;
    color: var(--ivory-50);
    background: var(--brand-950);
    padding-block: 3rem 0;
  }

  .ishraq-hero__bg {
    position: absolute;
    inset: 0;
    background:
      radial-gradient(ellipse at 20% 20%, #d8b77a22, transparent 55%),
      radial-gradient(ellipse at 90% 0%, #71314955, transparent 45%);
  }

  .ishraq-hero__grid {
    position: relative;
    display: grid;
    gap: 2.5rem;
    align-items: center;
  }

  .ishraq-hero__badge {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.375rem 1rem;
    border-radius: 9999px;
    border: 1px solid color-mix(in srgb, var(--brass-300) 30%, transparent);
    background: color-mix(in srgb, var(--white) 10%, transparent);
    font-size: 0.75rem;
    font-weight: 800;
    color: var(--brass-300);
  }

  .ishraq-hero h1 {
    margin-top: 1.25rem;
    font-size: clamp(2.2rem, 5vw, 3.25rem);
    line-height: 1.15;
  }

  .ishraq-hero__accent {
    color: var(--brass-300);
  }

  .ishraq-hero__lead {
    margin-top: 1.25rem;
    max-width: 32rem;
    color: color-mix(in srgb, var(--ivory-50) 85%, transparent);
  }

  .ishraq-hero__proof {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 1rem;
    margin-top: 1.25rem;
  }

  .ishraq-hero__stars {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    font-weight: 800;
    font-size: 0.9375rem;
  }

  .ishraq-hero__stars-icons {
    color: #f5c518;
    letter-spacing: 1px;
  }

  .ishraq-hero__review-count {
    font-weight: 600;
    font-size: 0.8125rem;
    color: color-mix(in srgb, var(--ivory-50) 70%, transparent);
  }

  .ishraq-hero__orders {
    font-weight: 800;
    font-size: 0.8125rem;
    color: color-mix(in srgb, var(--ivory-50) 80%, transparent);
  }

  .ishraq-hero__badges {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-top: 1rem;
  }

  .ishraq-hero__trust-chip {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    padding: 0.35rem 0.75rem;
    border-radius: 9999px;
    border: 1px solid color-mix(in srgb, var(--white) 20%, transparent);
    background: color-mix(in srgb, var(--white) 8%, transparent);
    font-size: 0.75rem;
    font-weight: 700;
    color: var(--ivory-50);
  }

  .ishraq-hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: 1.75rem;
  }

  .ishraq-hero__cta-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    padding: 0.9rem 2rem;
    border-radius: 9999px;
    background: linear-gradient(135deg, #e84c7a, #c2185b);
    color: var(--white);
    font-size: 1rem;
    font-weight: 800;
    text-decoration: none;
    box-shadow: 0 8px 28px -6px rgba(200, 30, 90, 0.55);
    transition: transform 0.2s, box-shadow 0.2s, background 0.2s;
  }

  .ishraq-hero__cta-btn:hover {
    transform: translateY(-2px);
    box-shadow: 0 12px 36px -6px rgba(200, 30, 90, 0.65);
    background: linear-gradient(135deg, #f06292, #d81b60);
  }

  .ishraq-hero__cta-btn:active {
    transform: translateY(0);
  }

  .ishraq-hero__cta-btn svg {
    transition: transform 0.2s;
  }

  .ishraq-hero__cta-btn:hover svg {
    transform: translateX(3px);
  }

  .ishraq-hero__micro-trust {
    display: flex;
    flex-wrap: wrap;
    gap: 1.25rem;
    margin-top: 1rem;
    font-size: 0.8125rem;
    font-weight: 700;
    color: color-mix(in srgb, var(--ivory-50) 75%, transparent);
  }

  .ishraq-hero__media {
    position: relative;
  }

  .ishraq-hero__image-wrap {
    position: relative;
    overflow: hidden;
    border-radius: 1.75rem;
    border: 1px solid color-mix(in srgb, var(--white) 10%, transparent);
    box-shadow: var(--shadow-hero);
  }

  .ishraq-hero__image-wrap img {
    width: 100%;
    aspect-ratio: 1 / 1;
    object-fit: cover;
  }

  .ishraq-hero__counters {
    position: relative;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1px;
    margin-top: 2.5rem;
    background: color-mix(in srgb, var(--white) 12%, transparent);
    border-top: 1px solid color-mix(in srgb, var(--white) 12%, transparent);
  }

  .ishraq-hero__counter {
    padding: 1.25rem;
    text-align: center;
    background: var(--brand-950);
  }

  .ishraq-hero__counter strong {
    display: block;
    font-size: clamp(1.5rem, 3vw, 2rem);
    font-weight: 900;
    color: var(--brass-300);
  }

  .ishraq-hero__counter span {
    display: block;
    margin-top: 0.25rem;
    font-size: 0.75rem;
    font-weight: 700;
    color: color-mix(in srgb, var(--ivory-50) 70%, transparent);
  }

  @media (min-width: 768px) {
    .ishraq-hero {
      padding-block: 5rem 0;
    }

    .ishraq-hero__grid {
      grid-template-columns: 1fr 1fr;
      gap: 3rem;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Ishraq Hero",
  "settings": [
    { "type": "text", "id": "badge", "label": "Badge text" },
    { "type": "text", "id": "heading_line_1", "label": "Heading line 1" },
    { "type": "text", "id": "heading_line_2", "label": "Heading accent" },
    { "type": "textarea", "id": "lead", "label": "Lead paragraph" },
    { "type": "text", "id": "rating", "label": "Rating number", "default": "4.8" },
    { "type": "text", "id": "review_count", "label": "Review count", "default": "340" },
    { "type": "text", "id": "orders_count", "label": "Orders count", "default": "960" },
    { "type": "checkbox", "id": "show_onssa", "label": "Show ONSSA badge", "default": true },
    { "type": "checkbox", "id": "show_lab", "label": "Show lab-tested badge", "default": true },
    { "type": "checkbox", "id": "show_halal", "label": "Show halal badge", "default": true },
    { "type": "text", "id": "cta_label", "label": "CTA label", "default": "شوفي اللي يشتغل فعلاً" },
    { "type": "url", "id": "cta_link", "label": "CTA link" },
    { "type": "image_picker", "id": "image", "label": "Hero image" }
  ],
  "blocks": [
    {
      "type": "counter",
      "name": "Counter",
      "settings": [
        { "type": "text", "id": "value", "label": "Value" },
        { "type": "text", "id": "label", "label": "Label" }
      ]
    }
  ],
  "presets": [{ "name": "Ishraq Hero" }]
}
{% endschema %}
