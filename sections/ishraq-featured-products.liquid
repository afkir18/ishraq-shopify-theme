<section class="ishraq-products page-width">
  <p class="section-label">{{ section.settings.label | default: "منتجاتنا" }}</p>
  <div class="ishraq-products__head">
    <div>
      <h2>{{ section.settings.heading | default: "تركيبتان مختارتين بعناية" }}</h2>
      <p>{{ section.settings.subheading | default: "كل منتوج كيخدم هدف واحد بوضوح — عناية من الداخل، أو روتين المساء." }}</p>
    </div>
    <a href="{{ section.settings.collection.url | default: routes.all_products_collection_url }}" class="ishraq-products__link">
      كل المنتجات ←
    </a>
  </div>

  <div class="ishraq-products__grid">
    {% assign collection = section.settings.collection %}
    {% if collection != blank %}
      {% for product in collection.products limit: section.settings.products_to_show %}
        <article class="ishraq-product-card card">
          <a href="{{ product.url }}" class="ishraq-product-card__media">
            {% if product.featured_image %}
              {{ product.featured_image | image_url: width: 800 | image_tag: loading: 'lazy', alt: product.title }}
            {% endif %}
          </a>
          <div class="ishraq-product-card__body">
            {% if forloop.first %}
              <span class="ishraq-product-card__badge">عناية من الداخل</span>
            {% elsif forloop.index == 2 %}
              <span class="ishraq-product-card__badge">روتين المساء</span>
            {% endif %}
            <h3><a href="{{ product.url }}">{{ product.title }}</a></h3>
            <p>{{ product.description | strip_html | truncate: 120 }}</p>
            <p class="ishraq-product-card__price">من {{ product.price_min | money }}</p>
            <a href="{{ product.url }}" class="btn btn--secondary">شوفي التفاصيل</a>
          </div>
        </article>
      {% endfor %}
    {% else %}
      <p>اختاري مجموعة منتجات من إعدادات القسم.</p>
    {% endif %}
  </div>
</section>

{% stylesheet %}
  .ishraq-products {
    padding-block: 4rem 5rem;
  }

  .ishraq-products__head {
    display: flex;
    flex-wrap: wrap;
    align-items: end;
    justify-content: space-between;
    gap: 1rem;
    margin-bottom: 2.5rem;
  }

  .ishraq-products__head h2 {
    max-width: 32rem;
    font-size: clamp(1.875rem, 4vw, 2.25rem);
    color: var(--brand-950);
  }

  .ishraq-products__head p {
    margin-top: 0.75rem;
    max-width: 32rem;
    color: var(--ink-600);
  }

  .ishraq-products__link {
    font-weight: 700;
    color: var(--brand-800);
    text-decoration: none;
  }

  .ishraq-products__grid {
    display: grid;
    gap: 1.5rem;
  }

  .ishraq-product-card {
    overflow: hidden;
    background: var(--white);
  }

  .ishraq-product-card__media img {
    width: 100%;
    aspect-ratio: 4 / 3;
    object-fit: cover;
  }

  .ishraq-product-card__body {
    padding: 1.25rem;
  }

  .ishraq-product-card__badge {
    display: inline-block;
    margin-bottom: 0.5rem;
    padding: 0.25rem 0.625rem;
    border-radius: 9999px;
    background: color-mix(in srgb, var(--brand-800) 10%, transparent);
    font-size: 0.75rem;
    font-weight: 800;
    color: var(--brand-800);
  }

  .ishraq-product-card h3 {
    font-size: 1.125rem;
  }

  .ishraq-product-card h3 a {
    color: inherit;
    text-decoration: none;
  }

  .ishraq-product-card__body > p {
    margin-top: 0.5rem;
    font-size: 0.875rem;
    color: var(--ink-600);
  }

  .ishraq-product-card__price {
    margin-top: 0.75rem;
    font-weight: 800;
    color: var(--brand-950);
  }

  .ishraq-product-card .btn {
    margin-top: 1rem;
  }

  @media (min-width: 768px) {
    .ishraq-products__grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Ishraq Featured Products",
  "settings": [
    { "type": "text", "id": "label", "label": "Section label" },
    { "type": "text", "id": "heading", "label": "Heading" },
    { "type": "textarea", "id": "subheading", "label": "Subheading" },
    { "type": "collection", "id": "collection", "label": "Collection" },
    { "type": "range", "id": "products_to_show", "min": 2, "max": 4, "step": 1, "default": 2, "label": "Products to show" }
  ],
  "presets": [{ "name": "Ishraq Featured Products" }]
}
{% endschema %}
