<section id="ishraq-categories" class="ishraq-cats page-width">
  <div class="ishraq-cats__head">
    <p class="section-label">{{ section.settings.label | default: 'عالم إشراق' }}</p>
    <h2>{{ section.settings.heading | default: 'كل روتينك — من البشرة للشعر للمكملات' }}</h2>
    <p class="ishraq-cats__lead">
      {{ section.settings.subheading | default: 'إشراق دار واحدة لعدة احتياجات. اختاري الفئة اللي تناسبك اليوم — وغادي تلقاي غوميز، عناية يومية، ومكملات بتركيبة واضحة.' }}
    </p>
  </div>

  <div class="ishraq-cats__grid">
    {% for block in section.blocks %}
      {% assign cat_url = routes.all_products_collection_url %}
      {% if block.settings.collection != blank %}
        {% assign cat_url = block.settings.collection.url %}
      {% elsif block.settings.handle != blank and collections[block.settings.handle] != blank %}
        {% assign cat_url = collections[block.settings.handle].url %}
      {% endif %}
      <a
        href="{{ cat_url }}"
        class="ishraq-cats__card ishraq-cats__card--{{ forloop.index }}"
        {{ block.shopify_attributes }}
      >
        <div class="ishraq-cats__media">
          {% if block.settings.image != blank %}
            {{
              block.settings.image
              | image_url: width: 900
              | image_tag: loading: 'lazy', alt: block.settings.title
            }}
          {% elsif block.settings.collection.featured_image %}
            {{
              block.settings.collection.featured_image
              | image_url: width: 900
              | image_tag: loading: 'lazy', alt: block.settings.title
            }}
          {% else %}
            <div class="ishraq-cats__fallback" aria-hidden="true"></div>
          {% endif %}
        </div>
        <div class="ishraq-cats__body">
          {% if block.settings.badge != blank %}
            <span class="ishraq-cats__badge">{{ block.settings.badge }}</span>
          {% endif %}
          <h3>{{ block.settings.title }}</h3>
          {% if block.settings.body != blank %}
            <p>{{ block.settings.body }}</p>
          {% endif %}
          <span class="ishraq-cats__cta">{{ section.settings.card_cta | default: 'اكتشفي الفئة' }} ←</span>
        </div>
      </a>
    {% endfor %}
  </div>
</section>

{% stylesheet %}
  .ishraq-cats {
    padding-block: 4rem 1rem;
    scroll-margin-top: 5.5rem;
  }

  .ishraq-cats__head {
    max-width: 40rem;
    margin-bottom: 2.5rem;
  }

  .ishraq-cats__head h2 {
    font-size: clamp(1.875rem, 4vw, 2.25rem);
    color: var(--brand-950);
  }

  .ishraq-cats__lead {
    margin-top: 0.75rem;
    color: var(--ink-600);
  }

  .ishraq-cats__grid {
    display: grid;
    gap: 1.25rem;
  }

  .ishraq-cats__card {
    position: relative;
    overflow: hidden;
    display: flex;
    flex-direction: column;
    min-height: 22rem;
    border-radius: var(--radius-xl);
    text-decoration: none;
    color: var(--ivory-50);
    box-shadow: var(--shadow-soft);
  }

  .ishraq-cats__media {
    position: absolute;
    inset: 0;
  }

  .ishraq-cats__media img,
  .ishraq-cats__fallback {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .ishraq-cats__fallback {
    background:
      radial-gradient(ellipse at 20% 10%, #d8b77a55, transparent 50%),
      linear-gradient(160deg, var(--brand-950), var(--brand-700));
  }

  .ishraq-cats__card--2 .ishraq-cats__fallback {
    background:
      radial-gradient(ellipse at 80% 20%, #d8b77a44, transparent 50%),
      linear-gradient(160deg, #4a1f32, #8a4a5c);
  }

  .ishraq-cats__card--3 .ishraq-cats__fallback {
    background:
      radial-gradient(ellipse at 50% 0%, #d8b77a66, transparent 45%),
      linear-gradient(160deg, #2a4a38, #5a2638);
  }

  .ishraq-cats__media::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg, transparent 25%, color-mix(in srgb, var(--brand-950) 88%, transparent) 100%);
  }

  .ishraq-cats__body {
    position: relative;
    z-index: 1;
    margin-top: auto;
    padding: 1.5rem;
  }

  .ishraq-cats__badge {
    display: inline-block;
    margin-bottom: 0.5rem;
    padding: 0.2rem 0.625rem;
    border-radius: 9999px;
    background: var(--brass-600);
    font-size: 0.6875rem;
    font-weight: 800;
    color: var(--white);
  }

  .ishraq-cats__body h3 {
    font-size: 1.375rem;
    font-weight: 900;
  }

  .ishraq-cats__body p {
    margin-top: 0.4rem;
    font-size: 0.875rem;
    line-height: 1.6;
    color: color-mix(in srgb, var(--ivory-50) 85%, transparent);
  }

  .ishraq-cats__cta {
    display: inline-block;
    margin-top: 0.875rem;
    font-size: 0.875rem;
    font-weight: 800;
    color: var(--brass-300);
  }

  .ishraq-cats__card:hover .ishraq-cats__media img {
    transform: scale(1.04);
  }

  .ishraq-cats__media img {
    transition: transform 0.5s ease;
  }

  @media (min-width: 768px) {
    .ishraq-cats__grid {
      grid-template-columns: repeat(3, 1fr);
    }

    .ishraq-cats__card {
      min-height: 26rem;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Ishraq Categories",
  "settings": [
    { "type": "text", "id": "label", "label": "Section label" },
    { "type": "text", "id": "heading", "label": "Heading" },
    { "type": "textarea", "id": "subheading", "label": "Subheading" },
    { "type": "text", "id": "card_cta", "label": "Card link label", "default": "اكتشفي الفئة" }
  ],
  "blocks": [
    {
      "type": "category",
      "name": "Category",
      "limit": 6,
      "settings": [
        { "type": "text", "id": "title", "label": "Title" },
        { "type": "textarea", "id": "body", "label": "Description" },
        { "type": "text", "id": "badge", "label": "Badge" },
        { "type": "text", "id": "handle", "label": "Collection handle", "info": "Example: skincare, hair-care, supplements" },
        { "type": "collection", "id": "collection", "label": "Collection" },
        { "type": "image_picker", "id": "image", "label": "Image" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Ishraq Categories",
      "blocks": [
        {
          "type": "category",
          "settings": {
            "title": "العناية بالبشرة",
            "body": "ترطيب، نضارة، وروتين يومي واضح للبشرة."
          }
        },
        {
          "type": "category",
          "settings": {
            "title": "العناية بالشعر",
            "body": "قوة ولمعان وروتين مفهوم من الجذور للأطراف."
          }
        },
        {
          "type": "category",
          "settings": {
            "title": "المكملات الغذائية",
            "badge": "غوميز جديدة",
            "body": "غوميز ومكملات بتركيبة مفهومة — بلا وعود سحرية."
          }
        }
      ]
    }
  ]
}
{% endschema %}
