{% comment %}
  Ishraq FAQ page — accordion of common questions.
{% endcomment %}

{% liquid
  assign whatsapp_digits = section.settings.whatsapp_number | replace: ' ', '' | replace: '-', '' | replace: '+', '' | replace: '(', '' | replace: ')', ''
  assign whatsapp_message = section.settings.whatsapp_message | url_encode
  assign whatsapp_url = 'https://wa.me/' | append: whatsapp_digits
  if section.settings.whatsapp_message != blank
    assign whatsapp_url = whatsapp_url | append: '?text=' | append: whatsapp_message
  endif
  assign contact_url = pages.contact.url | default: '/pages/contact'
  assign shipping_url = pages['التوصيل-والإرجاع-1'].url | default: pages.shipping.url | default: '/pages/التوصيل-والإرجاع-1'
%}

<section class="ishraq-faq full-width">
  <div class="ishraq-faq__hero page-width">
    <h1>{{ section.settings.heading | default: 'أسئلة شائعة' }}</h1>
    <p class="ishraq-faq__lead">
      {{ section.settings.lead | default: 'أجوبة مختصرة على الطلب، التوصيل، والتركيبة. إلا ما لقيتيش جوابك، راسلينا على واتساب.' }}
    </p>
  </div>

  <div class="ishraq-faq__list page-width">
    {% for block in section.blocks %}
      {% if block.settings.question != blank %}
        <details class="ishraq-faq__item card" {{ block.shopify_attributes }}{% if forloop.first %} open{% endif %}>
          <summary>
            <span>{{ block.settings.question }}</span>
            <span class="ishraq-faq__icon" aria-hidden="true"></span>
          </summary>
          <div class="ishraq-faq__answer">
            {{ block.settings.answer | newline_to_br }}
          </div>
        </details>
      {% endif %}
    {% endfor %}
  </div>

  {% if page.content != blank %}
    <div class="ishraq-faq__page-content rte page-width card">
      {{ page.content }}
    </div>
  {% endif %}

  <div class="ishraq-faq__cta page-width">
    <p>{{ section.settings.cta_text | default: 'ما لقيتيش جوابك؟' }}</p>
    <div class="ishraq-faq__cta-actions">
      {% if whatsapp_digits != blank %}
        <a
          href="{{ whatsapp_url }}"
          class="btn btn--whatsapp btn--lg"
          target="_blank"
          rel="noopener noreferrer"
        >
          {{ section.settings.whatsapp_label | default: 'واتساب إشراق' }}
        </a>
      {% endif %}
      <a href="{{ contact_url }}" class="btn btn--secondary btn--lg">
        {{ section.settings.contact_label | default: 'تواصل معنا' }}
      </a>
      <a href="{{ shipping_url }}" class="btn btn--secondary btn--lg">
        {{ section.settings.shipping_label | default: 'التوصيل والإرجاع' }}
      </a>
    </div>
  </div>
</section>

{% stylesheet %}
  .ishraq-faq {
    padding-block: 2.5rem 4.5rem;
  }

  .ishraq-faq__hero {
    max-width: 42rem;
    margin-inline: auto;
    margin-bottom: 2.5rem;
    text-align: center;
  }

  .ishraq-faq__hero h1 {
    font-size: clamp(1.875rem, 5vw, 2.5rem);
    font-weight: 900;
    color: var(--brand-950);
  }

  .ishraq-faq__lead {
    margin-top: 0.75rem;
    font-size: 1.0625rem;
    line-height: 1.8;
    color: var(--ink-600);
  }

  .ishraq-faq__list {
    max-width: 46rem;
    margin-inline: auto;
    display: grid;
    gap: 0.75rem;
  }

  .ishraq-faq__item {
    padding: 0;
    overflow: hidden;
  }

  .ishraq-faq__item summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding: 1.15rem 1.25rem;
    cursor: pointer;
    list-style: none;
    font-weight: 800;
    color: var(--brand-950);
  }

  .ishraq-faq__item summary::-webkit-details-marker {
    display: none;
  }

  .ishraq-faq__icon {
    position: relative;
    flex-shrink: 0;
    width: 1.5rem;
    height: 1.5rem;
    border-radius: 9999px;
    background: color-mix(in srgb, var(--brand-800) 8%, transparent);
  }

  .ishraq-faq__icon::before,
  .ishraq-faq__icon::after {
    content: '';
    position: absolute;
    inset: 50%;
    background: var(--brand-800);
    border-radius: 1px;
  }

  .ishraq-faq__icon::before {
    width: 0.65rem;
    height: 2px;
    margin: -1px -0.325rem;
  }

  .ishraq-faq__icon::after {
    width: 2px;
    height: 0.65rem;
    margin: -0.325rem -1px;
    transition: opacity 0.15s;
  }

  .ishraq-faq__item[open] .ishraq-faq__icon::after {
    opacity: 0;
  }

  .ishraq-faq__answer {
    padding: 0 1.25rem 1.25rem;
    font-size: 0.9875rem;
    line-height: 1.85;
    color: var(--ink-600);
  }

  .ishraq-faq__page-content {
    max-width: 46rem;
    margin: 1.75rem auto 0;
    padding: 1.25rem;
  }

  .ishraq-faq__cta {
    margin-top: 2.75rem;
    text-align: center;
  }

  .ishraq-faq__cta p {
    margin-bottom: 1rem;
    font-weight: 800;
    color: var(--brand-950);
  }

  .ishraq-faq__cta-actions {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.75rem;
  }

  .btn--whatsapp {
    background: #25d366;
    color: var(--white);
    box-shadow: 0 12px 30px -12px rgba(37, 211, 102, 0.65);
  }

  .btn--whatsapp:hover {
    background: color-mix(in srgb, #25d366 88%, black);
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Ishraq FAQ",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "أسئلة شائعة"
    },
    {
      "type": "textarea",
      "id": "lead",
