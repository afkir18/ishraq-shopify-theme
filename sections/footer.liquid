<footer class="ishraq-footer full-width">
  <div class="ishraq-footer__grid page-width">
    <div class="ishraq-footer__brand">
      <a href="{{ routes.root_url }}">
        <img
          src="{{ 'logo-ishraq.png' | asset_url }}"
          alt="{{ shop.name }}"
          width="128"
          height="31"
          loading="lazy"
        >
      </a>
      <p>دار مغربية للعناية والجمال — بشرة، شعر، ومكملات موثوقة لروتينك اليومي فالدار.</p>
      <p class="ishraq-footer__tagline">تركيبة واضحة · تأكيد قبل الإرسال · أداء عند الاستلام</p>
    </div>

    <div>
      <h2>تسوقي</h2>
      {% assign skin_url = collections['العناية-بالبشرة'].url | default: collections['skincare'].url | default: routes.all_products_collection_url %}
      {% assign hair_url = collections['العناية-بالشعر'].url | default: collections['hair-care'].url | default: routes.all_products_collection_url %}
      {% assign supplements_url = collections['المكملات-الغذائية'].url | default: collections['supplements'].url | default: routes.all_products_collection_url %}
      {% if section.settings.collection_skincare != blank %}
        {% assign skin_url = section.settings.collection_skincare.url %}
      {% endif %}
      {% if section.settings.collection_hair != blank %}
        {% assign hair_url = section.settings.collection_hair.url %}
      {% endif %}
      {% if section.settings.collection_supplements != blank %}
        {% assign supplements_url = section.settings.collection_supplements.url %}
      {% endif %}
      <ul>
        <li><a href="{{ routes.all_products_collection_url }}">كل المنتجات</a></li>
        <li><a href="{{ skin_url }}">العناية بالبشرة</a></li>
        <li><a href="{{ hair_url }}">العناية بالشعر</a></li>
        <li><a href="{{ supplements_url }}">المكملات الغذائية</a></li>
      </ul>
    </div>

    <div>
      <h2>مساعدة</h2>
      {% assign shipping_url = section.settings.shipping_page.url | default: pages['التوصيل-والإرجاع-1'].url %}
      {% if shipping_url == blank %}
        {% assign shipping_url = pages['التوصيل-والإرجاع'].url %}
      {% endif %}
      {% if shipping_url == blank %}
        {% assign shipping_url = pages.shipping.url %}
      {% endif %}
      {% if shipping_url == blank %}
        {% assign shipping_url = pages['shipping-returns'].url %}
      {% endif %}
      {% if shipping_url == blank %}
        {% assign shipping_url = '/pages/التوصيل-والإرجاع-1' %}
      {% endif %}

      {% assign faq_url = section.settings.faq_page.url | default: pages['أسئلة-شائعة'].url %}
      {% if faq_url == blank %}
        {% assign faq_url = pages.faq.url %}
      {% endif %}
      {% if faq_url == blank %}
        {% assign faq_url = '/pages/أسئلة-شائعة' %}
      {% endif %}

      {% assign contact_url = section.settings.contact_page.url | default: pages.contact.url | default: '/pages/contact' %}
      <ul>
        <li><a href="{{ shipping_url }}">التوصيل والإرجاع</a></li>
        <li><a href="{{ faq_url }}">أسئلة شائعة</a></li>
        <li><a href="{{ contact_url }}">تواصل معنا</a></li>
      </ul>
    </div>
  </div>

  <div class="ishraq-footer__legal page-width">
    <p>© {{ 'now' | date: '%Y' }} إشراق · Ishraq · ishraq.ma</p>
    <p>
      المكملات ومنتجات العناية لا تحل محل استشارة مختص. راجعي صيدلي/طبيب عند الحاجة.
    </p>
  </div>
</footer>

{% if page.handle == 'thankyou' or page.template_suffix == 'thankyou' %}
<style>
  html.ishraq-thankyou-page .es-popup-button,
  html.ishraq-thankyou-page [class*="es-popup-button"],
  html.ishraq-thankyou-page [class*="es-sticky"],
  html.ishraq-thankyou-page [id^="es-popup"],
  html.ishraq-thankyou-page .es-cpb-button,
  html.ishraq-thankyou-page [class*="es-cpb"] {
    display: none !important;
    visibility: hidden !important;
    pointer-events: none !important;
  }
</style>
<script>
  (function () {
    if (location.pathname.indexOf('/pages/thankyou') === -1) return;
    document.documentElement.classList.add('ishraq-thankyou-page');
    function hideOrderButtons() {
      document.querySelectorAll('a, button, [role="button"], div, span').forEach(function (el) {
        var text = (el.textContent || '').replace(/\s+/g, ' ').trim();
        if (text === 'اضغط هنا للطلب' || text.indexOf('Order Now') !== -1) {
          el.style.setProperty('display', 'none', 'important');
          var parent = el.closest('[class*="es-"], [id^="es-"]');
          if (parent) parent.style.setProperty('display', 'none', 'important');
        }
      });
    }
    hideOrderButtons();
    document.addEventListener('DOMContentLoaded', hideOrderButtons);
    setTimeout(hideOrderButtons, 500);
    setTimeout(hideOrderButtons, 2000);
    new MutationObserver(hideOrderButtons).observe(document.documentElement, { childList: true, subtree: true });
  })();
</script>
{% endif %}

{% stylesheet %}
  .ishraq-footer {
    margin-top: 0;
    border-top: 1px solid color-mix(in srgb, var(--brand-800) 10%, transparent);
    background: var(--ivory-100);
  }

  .ishraq-footer__grid {
    display: grid;
    gap: 2.5rem;
    padding-block: 3.5rem;
  }

  .ishraq-footer__brand img {
    height: 1.75rem;
    width: auto;
  }

  .ishraq-footer__brand p,
  .ishraq-footer__tagline {
    margin-top: 1rem;
    font-size: 0.875rem;
    color: var(--ink-600);
  }

  .ishraq-footer h2 {
    margin-bottom: 0.75rem;
    font-size: 1rem;
    color: var(--brand-950);
  }

  .ishraq-footer ul {
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .ishraq-footer li + li {
    margin-top: 0.5rem;
  }

  .ishraq-footer a {
    font-size: 0.875rem;
    color: var(--ink-950);
    text-decoration: none;
  }

  .ishraq-footer a:hover {
    color: var(--brand-800);
  }

  .ishraq-footer__legal {
    border-top: 1px solid color-mix(in srgb, var(--brand-800) 10%, transparent);
    padding-block: 1.5rem;
    text-align: center;
    font-size: 0.75rem;
    color: var(--ink-600);
  }

  .ishraq-footer__legal p + p {
    margin-top: 0.5rem;
    max-width: 42rem;
    margin-inline: auto;
  }

  @media (min-width: 768px) {
    .ishraq-footer__grid {
      grid-template-columns: 1.2fr 1fr 1fr;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Footer",
  "settings": [
    {
      "type": "header",
      "content": "Categories"
    },
    {
      "type": "collection",
      "id": "collection_skincare",
      "label": "العناية بالبشرة"
    },
    {
      "type": "collection",
      "id": "collection_hair",
      "label": "العناية بالشعر"
    },
    {
      "type": "header",
      "content": "Help pages"
    },
    {
      "type": "page",
      "id": "shipping_page",
      "label": "التوصيل والإرجاع"
    },
    {
      "type": "page",
      "id": "faq_page",
      "label": "أسئلة شائعة"
    },
    {
      "type": "page",
      "id": "contact_page",
      "label": "تواصل معنا"
    }
  ]
}
{% endschema %}
